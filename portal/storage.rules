rules_version = '2';

// Security rules for Cloud Storage.
//
// The one place a client stores files is beneath a page of the workspace: the images and the
// files of its body, at pages/{pageId}/files/{fileId}/{fileName} (`pageFilePath` of
// portal/shared/src/page-blocks.ts). These rules read the page and the caller's access document
// from Firestore and make the decision that portal/firestore.rules makes for the page itself:
// those who may read the page read its files, and those who may edit it add a file. A file is
// never replaced, changed or removed by a client, so a page that names a file keeps it, and a
// file is read with the caller's own credentials each time, never through a download address
// that would outlive the caller's access. Every other path is denied to every caller, a
// programme administrator included. portal/tests/rules/storage.rules.test.ts tests both.
service firebase.storage {
  match /b/{bucket}/o {

    // The access document of the caller, or null while the account has none.
    function accessDocument() {
      return firestore.get(/databases/(default)/documents/access/$(request.auth.uid));
    }

    // `isActive()` and `isMember()` of portal/firestore.rules: a member in good standing whose
    // session began at or after the instant from which sessions are valid.
    function isMember() {
      return request.auth != null
        && accessDocument() != null
        && accessDocument().data.get('suspended', false) != true
        && accessDocument().data.member == true
        && (accessDocument().data.get('sessionsValidAfter', null) == null
          || request.auth.token.get('auth_time', -1) * 1000 >= accessDocument().data.sessionsValidAfter.toMillis());
    }

    // The helpers of the same names in portal/firestore.rules.
    function powersOf(a) {
      return a.mfaEnrolled == true
        && (a.get('secondFactorRequired', true) == false
          || request.auth.token.firebase.get('sign_in_second_factor', null) is string);
    }

    function sessionKeys(a) {
      return powersOf(a) ? a.scopeKeys : a.scopeKeys.removeAll(['programme', 'role:programme_admin', 'role:core_team']);
    }

    function readsPage(page, a) {
      return (a.programmeRoles.hasAny(['programme_admin', 'core_team']) && powersOf(a))
        || page.scopeKeys.hasAny(sessionKeys(a));
    }

    function managesPage(page, a) {
      return (('programme_admin' in a.programmeRoles || 'programme' in a.capabilities.get('pagesManage', [])) && powersOf(a))
        || (page.accessMode == 'inherit'
          && ((page.replicationId != null && ('rep:' + page.replicationId) in a.capabilities.get('pagesManage', []))
            || (page.laboratoryId != null && ('lab:' + page.laboratoryId) in a.capabilities.get('pagesManage', []))));
    }

    function pageAt(pageId) {
      return firestore.get(/databases/(default)/documents/pages/$(pageId));
    }

    // The files of a page.
    match /pages/{pageId}/files/{fileId}/{fileName} {
      allow get: if isMember()
        && pageAt(pageId) != null
        && readsPage(pageAt(pageId).data, accessDocument().data);
      // A new file, from an editor of the page, in the editor's own name, within the size limit
      // of `PAGE_FILE_MAX_BYTES`, under an identifier of twenty letters and digits. An upload
      // to a path that holds a file already is refused, so no file is ever replaced.
      allow create: if isMember()
        && resource == null
        && pageAt(pageId) != null
        && readsPage(pageAt(pageId).data, accessDocument().data)
        && (pageAt(pageId).data.levelKeys.edit.hasAny(sessionKeys(accessDocument().data))
          || managesPage(pageAt(pageId).data, accessDocument().data))
        && fileId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
