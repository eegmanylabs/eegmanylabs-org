rules_version = '2';

// Security rules for the portal's Firestore database.
//
// These rules are the enforcement point for every direct read and write from a browser.
// Anything not allowed here is denied. Writes that change who may do what, and writes that
// span several documents, go through callable functions, which use the Admin SDK and are not
// subject to these rules.
//
// Collection names match COLLECTIONS in portal/shared/src/paths.ts. Every allow statement has
// a test in portal/tests/rules that proves the allow and proves the matching denials.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function callerAccessPath() {
      return /databases/$(database)/documents/access/$(request.auth.uid);
    }

    // Whether an access document lets its account act: the account is not suspended, and the
    // session began at or after the instant from which sessions are valid. A missing field
    // counts as "not suspended" and "no such instant".
    function standingAllows(access) {
      return access.get('suspended', false) != true
        && (access.get('sessionsValidAfter', null) == null
          || request.auth.token.get('auth_time', -1) * 1000 >= access.sessionsValidAfter.toMillis());
    }

    // EVERY allow statement goes through this helper, directly or through another helper, so a
    // suspended account and an ended session are refused everything on their next request.
    // It is the decision `accountStanding` makes in portal/shared/src/schemas/access.ts, which
    // callable functions apply, and the two change together. An account that has no access
    // document yet is active: it has been granted nothing. Cost: one document read.
    function isActive() {
      return signedIn()
        && (!exists(callerAccessPath()) || standingAllows(get(callerAccessPath()).data));
    }

    function isOwner(uid) {
      return isActive() && request.auth.uid == uid;
    }

    // One document per account, maintained by the sessionStart function.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    // What an account may do. Written by functions only, so an account cannot grant itself
    // anything.
    match /access/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    // The audit trail is written by trusted code and is not readable from a browser.
    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    // Everything else, including collections that do not exist yet, is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
