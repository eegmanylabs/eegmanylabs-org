rules_version = '2';

// Security rules for the portal's Firestore database.
//
// These rules are the enforcement point for every direct read and write from a browser.
// Anything not allowed here is denied. Writes that change who may do what, and writes that
// span several documents, go through callable functions, which use the Admin SDK and are not
// subject to these rules.
//
// The rules implement the collection registry, portal/shared/src/collections.ts, which states
// for every collection who may read and who may write. Only the collections whose registry
// entry says `enforced` have rules here. Every other collection is closed to every client
// until the phase that builds its feature writes and tests its rules.
//
// How to read this file
//
//  - Every allow statement starts with a gate: isActive(), isOwner() or isMember(). A suspended
//    account and an ended session therefore pass none of them. The helpers that read the access
//    document without checking the caller's standing are only ever called behind a gate.
//  - Each match block states the most documents its rules read (the limit is 10 for a request).
//    access/{uid} is read with one get() and never with exists(), because the two count apart.
//  - A request may evaluate 1000 expressions at most, across every statement it touches, so a
//    statement decides who the caller is before it validates what the caller sent.
//  - The lists of fields named <entry>Fields, <entry>Required and <entry>Editable are compared
//    with the registry and the schemas by portal/tests/architecture/rules-source.test.ts, which
//    also fails when a block here matches a collection that the registry does not call enforced.
//
// Where rule-level validation stops
//
//  - Every client write is checked for its writer, its standard fields (the caller's uid, the
//    request time, a user write context), the keys it may hold, the keys it must hold, the
//    fields it may change, the references that tie it to its parent and its scope fields.
//  - Every field that a client may set is checked for its type, its enumerated values and the
//    caps of the shared schemas, so that a document these rules accept is a document its
//    schema accepts. A rule cannot iterate. A list of texts is checked as a whole (see
//    `strings`), a map of plain values through its keys and its values, and the items of a
//    checklist template one by one up to a fixed number. A field whose elements no rule can
//    check (a list of maps, a free map) is written by trusted code alone.
//  - A value that records a decision or an act names the account behind it: a review, an
//    approval, a completion and an acknowledgement are set by the caller, in the caller's own
//    name, at the request time, and what such a signature covers changes only together with it.
//  - A record made in the portal takes an identifier that Firestore generates. An identifier
//    that is a hash or a fold of its natural key (a candidate study, a vocabulary term) cannot
//    be rebuilt here. The integrity checker rebuilds it.
//  - The zod schemas of the shared package are the exact shape of a document. The web
//    application validates with them before it writes and after it reads, and the scheduled
//    integrity checker follows the references that no rule can follow.
//
// Every allow statement has a test in portal/tests/rules that proves the allow and proves the
// matching denials, and the matrix test fails when a statement is never granted or never refused.
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== The caller =====

    function signedIn() {
      return request.auth != null;
    }

    // access/{uid} of the caller, or null while the account has none. One document read,
    // however often a rule asks: a repeated get() of one path is served from the first.
    function accessDocument() {
      return get(/databases/$(database)/documents/access/$(request.auth.uid));
    }

    function access() {
      return accessDocument().data;
    }

    // Whether an access document lets its account act: the account is not suspended, and the
    // session began at or after the instant from which sessions are valid. A missing field
    // counts as "not suspended" and "no such instant".
    function standingAllows(a) {
      return a.get('suspended', false) != true
        && (a.get('sessionsValidAfter', null) == null
          || request.auth.token.get('auth_time', -1) * 1000 >= a.sessionsValidAfter.toMillis());
    }

    // EVERY allow statement goes through this helper, directly or through isOwner() or
    // isMember(), so a suspended account and an ended session are refused everything on their
    // next request. It is the decision `accountStanding` makes in portal/shared/src/access.ts,
    // which callable functions apply, and the two change together. An account that has no
    // access document yet is active: it has been granted nothing, and it reads only what is
    // its own. Cost: one document read.
    //
    // A helper that takes the access document as an argument reads it once, however often it
    // uses it. Every use of access() in a rule is evaluated again and counts towards the 1000
    // expressions of a request, which the checks of a large document need for themselves.
    function isActive() {
      return signedIn() && activeWith(accessDocument());
    }

    function activeWith(document) {
      return document == null || standingAllows(document.data);
    }

    // The tier SELF: the account that owns the document, whether or not it is a member yet.
    function isOwner(uid) {
      return isActive() && request.auth.uid == uid;
    }

    // The tier MEMBER: an account in good standing whose access document says it is an
    // approved member. Every direct write needs it, whoever the writer is.
    function isMember() {
      return isActive() && member();
    }

    // ===== What the access document grants =====
    //
    // The helpers of this section read the access document and do NOT check the caller's
    // standing. They are only ever called behind isActive(), isOwner() or isMember().

    function member() {
      return memberWith(accessDocument());
    }

    function memberWith(document) {
      return document != null && document.data.member == true;
    }

    // Whether the powers of a programme role or of a named grant are in effect: a factor is
    // enrolled (docs/DATA_MODEL.md, section 2), and the account need not present it or its
    // sign-in token says that one was verified in this session. A missing field counts as
    // "required". `programmePowersInEffect` of the shared package makes the same decision.
    function powersOf(a) {
      return a.mfaEnrolled == true
        && (a.get('secondFactorRequired', true) == false
          || request.auth.token.firebase.get('sign_in_second_factor', null) is string);
    }

    function programmePowers() {
      return powersOf(access());
    }

    // Programme administrators and the core team.
    function core() {
      return coreWith(access());
    }

    function coreWith(a) {
      return a.programmeRoles.hasAny(['programme_admin', 'core_team']) && powersOf(a);
    }

    // The scope keys in which the account holds a capability. Capabilities are keyed in
    // camelCase, as `capabilityField` of the shared package spells them.
    function heldFor(capability) {
      return access().capabilities.get(capability, []);
    }

    // The tier ADMIN: a programme administrator always, and the core team or the holder of a
    // named grant where the capability matrix confers the capability for the programme.
    function canForProgramme(capability) {
      return programmeWide(access(), capability);
    }

    function programmeWide(a, capability) {
      return ('programme_admin' in a.programmeRoles || 'programme' in a.capabilities.get(capability, []))
        && powersOf(a);
    }

    function canForReplication(capability, replicationId) {
      return ('rep:' + replicationId) in heldFor(capability) || canForProgramme(capability);
    }

    function canForLaboratory(capability, laboratoryId) {
      return ('lab:' + laboratoryId) in heldFor(capability) || canForProgramme(capability);
    }

    function canForUnit(capability, replicationId, laboratoryId) {
      return ('rep:' + replicationId) in heldFor(capability)
        || ('lab:' + laboratoryId) in heldFor(capability)
        || canForProgramme(capability);
    }

    // The right to manage the outputs of a replication, or of the programme where a record
    // names no replication.
    function canManageOutputsOf(replicationId) {
      return replicationId == null
        ? canForProgramme('replicationsManage')
        : canForReplication('replicationsManage', replicationId);
    }

    function leads(replicationId) {
      return replicationId in access().leadReplicationIds;
    }

    // The leads of a replication and its confirmed team: everyone who holds its scope key.
    function onTeam(replicationId) {
      return leads(replicationId) || replicationId in access().teamReplicationIds;
    }

    function coordinates(laboratoryId) {
      return laboratoryId in access().coordinatorLaboratoryIds;
    }

    // The coordinators and the members of a laboratory: everyone who holds its scope key.
    function inLaboratory(laboratoryId) {
      return coordinates(laboratoryId) || laboratoryId in access().memberLaboratoryIds;
    }

    // The scope keys that stand for the powers of a programme role: PROGRAMME_POWER_SCOPE_KEYS
    // of portal/shared/src/access.ts. The access document lists them once a factor is enrolled.
    function programmeScopeKeys() {
      return ['programme', 'role:programme_admin', 'role:core_team'];
    }

    // The tier SCOPED for a document that carries the resolved audience in `scopeKeys`. The keys
    // of the programme count only while the programme powers are in effect, so a session that
    // lacks the second factor holds none of them: `sessionScopeKeys` of the shared package.
    function holdsScopeOf(data) {
      return data.scopeKeys.hasAny(sessionKeys(access()));
    }

    function sessionKeys(a) {
      return powersOf(a) ? a.scopeKeys : a.scopeKeys.removeAll(programmeScopeKeys());
    }

    // The tier SCOPED for a document whose scope is its own replication and laboratory. A list
    // query satisfies it by constraining `scopeKeys` to keys the caller holds, or
    // `replicationId` or `laboratoryId` to a unit the caller belongs to.
    function withinUnit(data) {
      return holdsScopeOf(data) || onTeam(data.replicationId) || inLaboratory(data.laboratoryId);
    }

    // ===== Requests =====

    // One document, or a list that says how many documents it asks for. The bound is
    // LIVE_QUERY_MAX_LIMIT of the web data layer.
    function boundedRead() {
      return request.method == 'get' || request.query.limit <= 1000;
    }

    function incoming() {
      return request.resource.data;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The write context of a change that a person makes directly (docs/DATA_MODEL.md, section 13).
    function userContext() {
      return {'origin': 'user', 'depth': 0, 'correlationId': null, 'causationId': null, 'auditEventId': null};
    }

    function standardFields() {
      return ['schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'archivedAt', 'writeContext'];
    }

    function appendOnlyFields() {
      return ['schemaVersion', 'createdAt', 'createdBy', 'writeContext'];
    }

    // What every update sets, and what an update may set to archive or restore a record.
    function touchFields() {
      return ['updatedAt', 'updatedBy', 'writeContext'];
    }

    function stampFields() {
      return ['updatedAt', 'updatedBy', 'writeContext', 'archivedAt'];
    }

    // A document that a client creates: nothing but the standard fields and `fields`, every
    // one of `required`, the caller as its author and the request time as its instant. A
    // client sets none of the provenance fields, which belong to the importers.
    function createdNow(d, fields, required) {
      return d.keys().hasOnly(standardFields().concat(fields))
        && d.keys().hasAll(required)
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid
        && d.archivedAt == null
        && d.writeContext == userContext();
    }

    // The same for a document of an append-only collection, which is never updated.
    function appendedNow(d, fields, required) {
      return d.keys().hasOnly(appendOnlyFields().concat(fields))
        && d.keys().hasAll(required)
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && d.writeContext == userContext();
    }

    // The identifier of a record that is made in the portal, where the data model calls the
    // identifier opaque: the twenty letters and digits that Firestore generates
    // (AUTO_ID_PATTERN of portal/shared/src/ids.ts). An importer derives its identifiers from
    // the source, and every derived identifier has another shape, so a client can never take
    // the place of a record that an import is going to write.
    function autoId(id) {
      return id.matches('^[A-Za-z0-9]{20}$');
    }

    // A document that a client changes: only the keys in `mayChange` differ from what is
    // stored, so the record of creation, the identifier, the scope fields, the origin, the
    // provenance and everything reserved for trusted code stay as they are, and no key that
    // the schema does not name can be added. The caller is its editor and the request time is
    // the instant of the edit.
    function updatedNow(d, mayChange, required) {
      return changed().hasOnly(mayChange)
        && d.keys().hasAll(required)
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid
        && d.writeContext == userContext()
        && archiveKept(d);
    }

    // A record that is not archived stays so or is archived at the request time. An archived
    // record is frozen: the one change it accepts is its restoration, which changes nothing
    // else. Archiving names the caller in `updatedBy` and nothing changes that afterwards, so
    // the record says who archived it: that account restores it, and so do programme
    // administrators and the core team.
    function archiveKept(d) {
      return resource.data.archivedAt == null
        ? (d.archivedAt == null || d.archivedAt == request.time)
        : (d.archivedAt == null
          && changed().hasOnly(stampFields())
          && (resource.data.updatedBy == request.auth.uid || core()));
    }

    // A value exactly as a source gave it lives in a field ending in `Source`. On a document
    // that an import wrote, `fieldSources` names the source row as the origin of such a value,
    // so no client changes one there: a correction is a correction request.
    function sourceValuesKept(verbatimFields) {
      return !('sourceRecordIds' in resource.data) || !changed().hasAny(verbatimFields);
    }

    // ===== Values =====
    //
    // Each helper mirrors a type of portal/shared/src/schemas/base.ts and refuses every other
    // type: a method that a value does not have fails the statement that asks for it.

    // A name, a title or a label: 1 to 300 characters.
    function shortText(v) {
      return v.matches('(?s)^.{1,300}$');
    }

    // A description or a note: 1 to 10,000 characters.
    function longText(v) {
      return v.matches('(?s)^.+$') && v.size() <= 10000;
    }

    // A value exactly as a source gave it, which may be empty. Only a text can be joined to a
    // text, so the sum is a text of the same length.
    function verbatim(v) {
      return ('' + v).size() <= 10000;
    }

    // Rich text held in a field: 100 KiB of UTF-8 at most.
    function richText(v) {
      return v.toUtf8().size() <= 102400;
    }

    function docId(v) {
      return v.matches('^[^/]{1,500}$') && !(v in ['.', '..']) && !v.matches('^__.*__$');
    }

    // A stable key: letters, digits, hyphens and single underscores, with none at its end.
    function key(v) {
      return v.matches('^[A-Za-z0-9]([A-Za-z0-9-]|_[A-Za-z0-9-])*$') && v.size() <= 100;
    }

    // Only http and https, with a host name of letters, digits, hyphens and full stops and
    // nothing but printable ASCII after it, so that a stored address is safe to link to.
    function webAddress(v) {
      return v.matches('^(?i)https?://[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?(:[0-9]{1,4})?([/?#][!-~]*)?$')
        && v.size() <= 2048;
    }

    // A digital object identifier without a resolver prefix.
    function doi(v) {
      return v.matches('^10[.][0-9]{4,9}/[!-~]{1,280}$');
    }

    // A calendar date as ISO 8601 text that names a day that exists.
    function isoDate(v) {
      return v.matches('^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)$');
    }

    function count(v, maximum) {
      return v is int && v >= 0 && v <= maximum;
    }

    function year(v) {
      return v is int && v >= 1800 && v <= 2200;
    }

    // A rule cannot iterate, so a list is checked as a whole: joined into one text and split
    // again, it holds nothing but its own pieces only when every element is a text without a
    // line break. A number, a boolean or a map among the elements fails the comparison or the
    // join. The mark at the end keeps an empty last element from being dropped by the split.
    function strings(l) {
      return l.hasOnly((l.join('\n') + '\n|').split('\n'));
    }

    // A list of names or labels, each of 1 to 300 characters.
    function shortTexts(l, maximum) {
      return l.size() <= maximum
        && strings(l)
        && !('' in l)
        && l.join('\n').matches('^([^\n]{1,300}(\n|$))*$');
    }

    // A list of values as a source gave them, which hold 10,000 characters between them.
    function verbatims(l) {
      return l.size() <= 500 && strings(l) && l.join('').size() <= 10000;
    }

    // A list of document identifiers.
    function docIds(l) {
      return l.size() <= 500
        && strings(l)
        && !l.hasAny(['', '.', '..'])
        && l.join('\n').matches('^([^/\n]{1,500}(\n|$))*$')
        && !l.join('\n').matches('(?s)^(.*\n)?__[^\n]*__(\n.*)?$');
    }

    // The values of custom properties that a client writes directly: at most 500, under keys
    // without a full stop or a slash, each a text, a number, a boolean or null, and 10,000
    // characters between them. A list or a map among the values fails the join. Richer values
    // wait for the feature that defines custom properties.
    function customValues(m) {
      return m.size() <= 500
        && m.keys().hasOnly(m.keys().join('/').split('/'))
        && m.keys().join('/').matches('^([^./]{1,300}(/|$))*$')
        && m.values().join('').size() <= 10000;
    }

    // An actor and an instant that a client sets together: nobody, the stored pair, or the
    // caller and the request time. A client never names another account or another time.
    function namesCallerNow(actor, instant, storedActor, storedInstant) {
      return (actor == null && instant == null)
        || (actor == storedActor && instant == storedInstant)
        || (actor == request.auth.uid && instant == request.time);
    }

    // A signature that is new or absent: nobody, or the caller at the request time.
    function signedNowOrNot(actor, instant) {
      return (actor == null && instant == null) || (actor == request.auth.uid && instant == request.time);
    }

    // ENTITY_TYPES of portal/shared/src/entities.ts.
    function entityTypes() {
      return [
        'user', 'person', 'institution', 'group', 'programme', 'laboratory', 'equipmentConfiguration',
        'replication', 'hypothesis', 'protocol', 'protocolVersion', 'candidateStudy', 'participation',
        'recruitmentReport', 'taskList', 'task', 'page', 'thread', 'comment', 'attachment', 'database',
        'databaseRow', 'view', 'dashboard', 'storageEndpoint', 'dataset', 'processingRun', 'manuscript',
        'contributorTable', 'contributor', 'decision', 'risk', 'incident', 'meeting', 'progressReport',
        'documentLink', 'source', 'importBatch'
      ];
    }

    // SPECIAL_CATEGORY_FIELDS of portal/shared/src/schemas/identity.ts.
    function specialCategoryFields() {
      return [
        'genderSource', 'genderCategory', 'genderSelfDescribed',
        'ethnicitySource', 'ethnicityCategory', 'ethnicitySelfDescribed'
      ];
    }

    // The notification types of portal/shared/src/schemas/identity.ts.
    function notificationTypes() {
      return [
        'mention', 'assignment', 'comment', 'statusChange', 'dueSoon', 'overdue', 'reminder',
        'claimDecision', 'roleDecision', 'protocolUpdate', 'milestone', 'integrationFailure'
      ];
    }

    // ===== Documents that rules read to decide =====
    //
    // get() gives null for a document that does not exist. A rule that reads a field of such a
    // document fails, and `a || b` still holds when `a` fails and `b` is true, so a rule that
    // must not pass for a missing parent asks for the document itself first.

    function personDocument(personId) {
      return get(/databases/$(database)/documents/persons/$(personId));
    }

    function person(personId) {
      return personDocument(personId).data;
    }

    function participationDocument(participationId) {
      return get(/databases/$(database)/documents/participations/$(participationId));
    }

    function participation(participationId) {
      return participationDocument(participationId).data;
    }

    function manuscript(manuscriptId) {
      return get(/databases/$(database)/documents/manuscripts/$(manuscriptId)).data;
    }

    function contributor(contributorId) {
      return get(/databases/$(database)/documents/contributors/$(contributorId)).data;
    }

    function replicationExists(replicationId) {
      return exists(/databases/$(database)/documents/replications/$(replicationId));
    }

    function laboratoryExists(laboratoryId) {
      return exists(/databases/$(database)/documents/laboratories/$(laboratoryId));
    }

    function personExists(personId) {
      return exists(/databases/$(database)/documents/persons/$(personId));
    }

    // ===== Identity and access (docs/DATA_MODEL.md, section 3) =====

    // A favourite, a recent and a subscription name a record by its type and identifier, and
    // the identifier of the document is the two joined together.
    function validEntityReference(d, uid, referenceId) {
      return d.uid == uid
        && d.entityType in entityTypes()
        && docId(d.entityId)
        && referenceId == d.entityType + '__' + d.entityId;
    }

    // One document per account, maintained by the sessionStart function.
    // Reads: 1 (access).
    match /users/{uid} {
      allow get: if isOwner(uid);

      // Reads: 1 (access).
      match /favourites/{referenceId} {
        function userFavouritesFields() { return ['uid', 'entityType', 'entityId']; }
        function userFavouritesRequired() { return ['uid', 'entityType', 'entityId']; }
        function userFavouritesEditable() { return ['uid']; }

        allow read: if isOwner(uid) && boundedRead();
        allow create: if isMember() && request.auth.uid == uid
          && createdNow(incoming(), userFavouritesFields(), userFavouritesRequired())
          && validEntityReference(incoming(), uid, referenceId);
        allow update: if isMember() && request.auth.uid == uid
          && updatedNow(incoming(), stampFields().concat(userFavouritesEditable()), userFavouritesRequired())
          && incoming().uid == uid;
        allow delete: if isMember() && request.auth.uid == uid;
      }

      // `updatedAt` of a recent is the time of the latest visit.
      // Reads: 1 (access).
      match /recents/{referenceId} {
        function userRecentsFields() { return ['uid', 'entityType', 'entityId']; }
        function userRecentsRequired() { return ['uid', 'entityType', 'entityId']; }
        function userRecentsEditable() { return ['uid']; }

        allow read: if isOwner(uid) && boundedRead();
        allow create: if isMember() && request.auth.uid == uid
          && createdNow(incoming(), userRecentsFields(), userRecentsRequired())
          && validEntityReference(incoming(), uid, referenceId);
        allow update: if isMember() && request.auth.uid == uid
          && updatedNow(incoming(), stampFields().concat(userRecentsEditable()), userRecentsRequired())
          && incoming().uid == uid;
        allow delete: if isMember() && request.auth.uid == uid;
      }

      // Written by functions. The owner may mark a notification as read or as unread, and
      // nothing else.
      // Reads: 1 (access).
      match /notifications/{notificationId} {
        function userNotificationsEditableBySelf() { return ['readAt']; }

        allow read: if isOwner(uid) && boundedRead();
        allow update: if isMember() && request.auth.uid == uid
          && updatedNow(incoming(), touchFields().concat(userNotificationsEditableBySelf()), [])
          && (incoming().readAt == null || incoming().readAt == request.time);
      }

      // Reads: 1 (access).
      match /subscriptions/{referenceId} {
        function userSubscriptionsFields() { return ['uid', 'entityType', 'entityId', 'level']; }
        function userSubscriptionsRequired() { return ['uid', 'entityType', 'entityId', 'level']; }
        function userSubscriptionsEditable() { return ['uid', 'level']; }

        allow read: if isOwner(uid) && boundedRead();
        allow create: if isMember() && request.auth.uid == uid
          && createdNow(incoming(), userSubscriptionsFields(), userSubscriptionsRequired())
          && validEntityReference(incoming(), uid, referenceId)
          && incoming().level in ['all', 'mentions', 'none'];
        allow update: if isMember() && request.auth.uid == uid
          && updatedNow(incoming(), stampFields().concat(userSubscriptionsEditable()), userSubscriptionsRequired())
          && incoming().uid == uid
          && incoming().level in ['all', 'mentions', 'none'];
        allow delete: if isMember() && request.auth.uid == uid;
      }

      // Reads: 1 (access).
      match /settings/preferences {
        function userPreferencesFields() { return ['channels', 'digestFrequency', 'quietHours', 'typeSwitches']; }
        function userPreferencesRequired() { return ['channels', 'digestFrequency', 'quietHours', 'typeSwitches']; }
        function userPreferencesEditable() { return ['channels', 'digestFrequency', 'quietHours', 'typeSwitches']; }

        // Every switch is a boolean: the values of the map are compared with the two booleans.
        function validPreferences(d) {
          return d.channels.keys().hasOnly(['inApp', 'email'])
            && d.channels.inApp is bool
            && d.channels.email is bool
            && d.digestFrequency in ['off', 'daily', 'weekly']
            && (d.quietHours == null
              || (d.quietHours.keys().hasOnly(['start', 'end', 'timeZone'])
                && d.quietHours.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                && d.quietHours.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
                && d.quietHours.timeZone.matches('^.{1,64}$')))
            && d.typeSwitches.keys().hasOnly(notificationTypes())
            && d.typeSwitches.values().hasOnly([true, false]);
        }

        allow get: if isOwner(uid);
        allow create: if isMember() && request.auth.uid == uid
          && createdNow(incoming(), userPreferencesFields(), userPreferencesRequired())
          && validPreferences(incoming());
        allow update: if isMember() && request.auth.uid == uid
          && updatedNow(incoming(), stampFields().concat(userPreferencesEditable()), userPreferencesRequired())
          && validPreferences(incoming());
      }
    }

    // What an account may do. Written by functions only, so an account cannot grant itself
    // anything.
    // Reads: 1 (access).
    match /access/{uid} {
      allow get: if isOwner(uid);
    }

    // Roles, the overrides of the capability matrix, named grants and record grants are read
    // by whoever manages roles, and written by functions only.
    // Reads: 1 (access).
    match /roleAssignments/{assignmentId} {
      allow read: if isMember() && canForProgramme('rolesManage') && boundedRead();
    }

    // Reads: 1 (access).
    match /roleCapabilities/{role} {
      allow read: if isMember() && canForProgramme('rolesManage') && boundedRead();
    }

    // Reads: 1 (access).
    match /capabilityGrants/{grantId} {
      allow read: if isMember() && canForProgramme('rolesManage') && boundedRead();
    }

    // Reads: 1 (access).
    match /recordGrants/{grantId} {
      allow read: if isMember() && canForProgramme('rolesManage') && boundedRead();
    }

    // Reads: 1 (access).
    match /groups/{groupKey} {
      allow read: if isMember() && boundedRead();
    }

    // An account name in an external system, read within the scope of its owner.
    // Reads: 2 (access, the owner).
    match /externalAccounts/{accountId} {
      function externalAccountsFields() { return ['ownerType', 'ownerId', 'system', 'accountName', 'notes', 'scopeKeys']; }
      function externalAccountsRequired() { return ['ownerType', 'ownerId', 'system', 'accountName', 'scopeKeys']; }
      function externalAccountsEditable() { return ['ownerType', 'ownerId', 'system', 'accountName', 'notes']; }

      // The audience of an account is its owner: the scope keys are rebuilt from the owner,
      // the owner exists, and the caller manages the owner. Only programme administrators and
      // the core team record the account of a group or of a person.
      function ownedAndManaged(d) {
        return (d.ownerType == 'replication'
            && d.scopeKeys == ['rep:' + d.ownerId]
            && (core() || leads(d.ownerId))
            && replicationExists(d.ownerId))
          || (d.ownerType == 'laboratory'
            && d.scopeKeys == ['lab:' + d.ownerId]
            && (core() || coordinates(d.ownerId))
            && laboratoryExists(d.ownerId))
          || (d.ownerType == 'group'
            && d.scopeKeys == ['group:' + d.ownerId]
            && core()
            && exists(/databases/$(database)/documents/groups/$(d.ownerId)))
          || (d.ownerType == 'person'
            && core()
            && d.scopeKeys == (person(d.ownerId).userId == null ? [] : ['user:' + person(d.ownerId).userId]));
      }

      // The name of an account is never a secret: a credential belongs in the secret store.
      function validExternalAccount(d) {
        return d.system in ['cloud', 'bids', 'eegnet', 'sftp', 'osf', 'github', 'google', 'quire']
          && shortText(d.accountName)
          && longText(d.get('notes', 'x'));
      }

      allow read: if isMember() && (core() || holdsScopeOf(resource.data)) && boundedRead();
      allow create: if isMember()
        && autoId(accountId)
        && docId(incoming().ownerId)
        && ownedAndManaged(incoming())
        && createdNow(incoming(), externalAccountsFields(), externalAccountsRequired())
        && validExternalAccount(incoming());
      allow update: if isMember()
        && (core() || resource.data.scopeKeys.hasAny(access().manageScopeKeys))
        && updatedNow(incoming(), stampFields().concat(externalAccountsEditable()), externalAccountsRequired())
        && incoming().ownerType == resource.data.ownerType
        && incoming().ownerId == resource.data.ownerId
        && validExternalAccount(incoming());
    }

    // What a user may know of their own claim. The evidence and the decision are for reviewers.
    // Reads: 1 (access).
    match /accountClaims/{uid} {
      allow get: if isOwner(uid);

      // Reads: 1 (access).
      match /private/review {
        allow get: if isMember() && canForProgramme('claimsReview');
      }
    }

    // A request to represent a laboratory: for the requesting user and for whoever decides
    // such requests for that laboratory.
    // Reads: 1 (access).
    match /labClaims/{claimId} {
      allow read: if isActive()
        && (resource.data.uid == request.auth.uid
          || (member() && canForLaboratory('labsClaimsReview', resource.data.laboratoryId)))
        && boundedRead();

      // Reads: 2 (access, the claim).
      match /private/review {
        allow get: if isMember()
          && canForLaboratory(
            'labsClaimsReview',
            get(/databases/$(database)/documents/labClaims/$(claimId)).data.laboratoryId
          );
      }
    }

    // A member's request to correct an imported record. A member sees only their own, and
    // whoever resolves the review queue sees them all. A resolution is a callable function.
    // Reads: 1 (access).
    match /correctionRequests/{requestId} {
      function correctionRequestsFields() {
        return ['uid', 'entityType', 'entityId', 'field', 'proposedValue', 'message', 'status', 'resolvedBy', 'resolvedAt'];
      }
      function correctionRequestsRequired() {
        return ['uid', 'entityType', 'entityId', 'field', 'proposedValue', 'status', 'resolvedBy', 'resolvedAt'];
      }
      function correctionRequestsEditableBySelf() { return ['status']; }

      // Whoever resolves the queue reads every request, and that includes accounts that may not
      // read special-category data. A request therefore names a field as the schemas spell
      // one, by letters and digits alone, so that white space cannot disguise the name, and it
      // never names a field of the special categories, in whatever case the name is written:
      // `namesSpecialCategory` of portal/shared/src/schemas/identity.ts.
      function correctableField(field) {
        return field.matches('^[A-Za-z][A-Za-z0-9]{0,99}$')
          && !(field in specialCategoryFields())
          && !field.lower().matches('.*(gender|ethnic|demograph).*');
      }

      // Whether the record exists is left to the function that resolves the request: a rule
      // cannot turn every entity type into a path.
      function validCorrectionRequest(d) {
        return d.uid == request.auth.uid
          && d.entityType in entityTypes()
          && docId(d.entityId)
          && correctableField(d.field)
          && (d.proposedValue is bool || d.proposedValue is number || verbatim(d.proposedValue))
          && longText(d.get('message', 'x'))
          && d.status == 'open'
          && d.resolvedBy == null
          && d.resolvedAt == null;
      }

      allow read: if isActive()
        && (resource.data.uid == request.auth.uid || (member() && canForProgramme('reconciliationResolve')))
        && boundedRead();
      allow create: if isMember()
        && autoId(requestId)
        && createdNow(incoming(), correctionRequestsFields(), correctionRequestsRequired())
        && validCorrectionRequest(incoming());
      // The creator may withdraw a request that is still open.
      allow update: if isMember() && resource.data.uid == request.auth.uid
        && updatedNow(incoming(), touchFields().concat(correctionRequestsEditableBySelf()), correctionRequestsRequired())
        && resource.data.status == 'open'
        && incoming().status == 'withdrawn';
    }

    // The directory document of a person. A person is created by an import or by a callable
    // function, which reserves the identity keys in the same transaction. The same function
    // changes the fields by which imports find a person again (the ORCID iD and the identifier
    // of the public website), so that no two people hold one key.
    // Reads: 1 (access).
    match /persons/{personId} {
      function personsRequired() {
        return [
          'slug', 'displayName', 'laboratoryIds', 'replicationIds', 'isCoreTeam', 'publicListing', 'coreRoles',
          'userId', 'claimedAt', 'custom', 'dataOrigin'
        ];
      }
      function personsEditable() {
        return [
          'givenName', 'middleName', 'familyName', 'displayName', 'countryCode', 'countrySource', 'isCoreTeam',
          'publicListing', 'coreRoles', 'headshotFilename', 'scholarUrl', 'universityUrl', 'labUrl', 'custom'
        ];
      }
      // The whitelist of a person who edits their own directory record.
      function personsEditableBySelf() { return ['scholarUrl', 'universityUrl', 'labUrl']; }
      function personsVerbatim() { return ['countrySource']; }

      function validPersonLinks(d) {
        return webAddress(d.get('scholarUrl', 'https://example.org'))
          && webAddress(d.get('universityUrl', 'https://example.org'))
          && webAddress(d.get('labUrl', 'https://example.org'));
      }

      function validPerson(d) {
        return shortText(d.get('givenName', 'x'))
          && shortText(d.get('middleName', 'x'))
          && shortText(d.get('familyName', 'x'))
          && shortText(d.displayName)
          && d.get('countryCode', 'GB').matches('^[A-Z]{2}$')
          && verbatim(d.get('countrySource', ''))
          && d.isCoreTeam is bool
          && d.publicListing in ['none', 'member', 'coreTeam']
          && shortTexts(d.coreRoles, 50)
          && shortText(d.get('headshotFilename', 'x'))
          && customValues(d.custom);
      }

      allow read: if isMember() && boundedRead();
      allow update: if isMember()
        && ((resource.data.userId == request.auth.uid
            && updatedNow(incoming(), touchFields().concat(personsEditableBySelf()), personsRequired()))
          || (canForProgramme('peopleManage')
            && updatedNow(incoming(), stampFields().concat(personsEditable()), personsRequired())
            && validPerson(incoming())
            && sourceValuesKept(personsVerbatim())))
        && validPersonLinks(incoming());

      // The email addresses of the person, which the claim flow trusts. Functions alone write
      // them. A scoped role reads through `people.contact.read`: whoever holds the capability
      // for a replication or a laboratory that the directory document names. The access
      // document lists those units by identifier, so that the unit in which the capability is
      // held is the unit of the person, and a capability held elsewhere opens nothing here.
      // Reads: 2 (access, the person).
      match /private/contact {
        allow get: if isActive()
          && (person(personId).userId == request.auth.uid
            || (member()
              && (canForProgramme('peopleContactRead')
                || access().contactReplicationIds.hasAny(person(personId).replicationIds)
                || access().contactLaboratoryIds.hasAny(person(personId).laboratoryIds))));
      }

      // Reads: 2 (access, the person).
      match /private/address {
        function personAddressFields() { return ['postalAddress']; }
        function personAddressRequired() { return ['postalAddress']; }
        function personAddressEditable() { return ['postalAddress']; }

        function validAddress(d) {
          return d.postalAddress is string && d.postalAddress.size() <= 2000;
        }

        allow get: if isActive()
          && (person(personId).userId == request.auth.uid || (member() && canForProgramme('peopleManage')));
        allow create: if isMember()
          && personDocument(personId) != null
          && (person(personId).userId == request.auth.uid || canForProgramme('peopleManage'))
          && createdNow(incoming(), personAddressFields(), personAddressRequired())
          && validAddress(incoming());
        allow update: if isMember()
          && (person(personId).userId == request.auth.uid || canForProgramme('peopleManage'))
          && updatedNow(incoming(), stampFields().concat(personAddressEditable()), personAddressRequired())
          && validAddress(incoming());
      }

      // Reads: 2 (access, the person).
      match /private/notes {
        function personNotesFields() { return ['privateNotes']; }
        function personNotesRequired() { return ['privateNotes']; }
        function personNotesEditable() { return ['privateNotes']; }

        allow get: if isMember() && canForProgramme('peopleManage');
        allow create: if isMember() && canForProgramme('peopleManage')
          && personExists(personId)
          && createdNow(incoming(), personNotesFields(), personNotesRequired())
          && verbatim(incoming().privateNotes);
        allow update: if isMember() && canForProgramme('peopleManage')
          && updatedNow(incoming(), stampFields().concat(personNotesEditable()), personNotesRequired())
          && verbatim(incoming().privateNotes);
      }

      // special/demographics has no rule: special-category data is never readable or writable
      // by a client, whatever its role. A callable function serves it.

      // Where a person works, which every member reads. A laboratory on an affiliation says
      // that the person belongs to it, and a request to represent a laboratory is checked
      // against it, so a person names only a laboratory that holds a confirmed member entry
      // for them, and nobody changes the laboratory afterwards.
      // Reads: 4 (access, the person, the institution, and the laboratory or the member entry).
      match /affiliations/{affiliationId} {
        function personAffiliationsFields() {
          return ['personId', 'institutionId', 'laboratoryId', 'affiliationSource', 'roleTitle', 'isPrimary', 'startDate', 'endDate'];
        }
        function personAffiliationsRequired() { return ['personId', 'isPrimary']; }
        function personAffiliationsEditable() {
          return ['personId', 'institutionId', 'affiliationSource', 'roleTitle', 'isPrimary', 'startDate', 'endDate'];
        }
        function personAffiliationsVerbatim() { return ['affiliationSource']; }

        function validAffiliation(d) {
          return d.personId == personId
            && docId(d.get('institutionId', 'x'))
            && verbatim(d.get('affiliationSource', ''))
            && shortText(d.get('roleTitle', 'x'))
            && d.isPrimary is bool
            && isoDate(d.get('startDate', '2000-01-01'))
            && isoDate(d.get('endDate', '2000-01-01'));
        }

        // An institution that a write introduces exists.
        function institutionNamed(d, stored) {
          return !('institutionId' in d)
            || d.institutionId == stored.get('institutionId', null)
            || exists(/databases/$(database)/documents/institutions/$(d.institutionId));
        }

        function confirmedMemberOf(laboratoryId) {
          let entry = get(/databases/$(database)/documents/laboratories/$(laboratoryId)/members/$(personId)).data;
          return entry.status == 'confirmed' && entry.archivedAt == null;
        }

        function laboratoryNamed(d) {
          return !('laboratoryId' in d)
            || (docId(d.laboratoryId)
              && (canForProgramme('peopleManage') ? laboratoryExists(d.laboratoryId) : confirmedMemberOf(d.laboratoryId)));
        }

        allow create: if isMember()
          && personDocument(personId) != null
          && (person(personId).userId == request.auth.uid || canForProgramme('peopleManage'))
          && autoId(affiliationId)
          && createdNow(incoming(), personAffiliationsFields(), personAffiliationsRequired())
          && validAffiliation(incoming())
          && institutionNamed(incoming(), {})
          && laboratoryNamed(incoming());
        allow update: if isMember()
          && (person(personId).userId == request.auth.uid || canForProgramme('peopleManage'))
          && updatedNow(incoming(), stampFields().concat(personAffiliationsEditable()), personAffiliationsRequired())
          && validAffiliation(incoming())
          && institutionNamed(incoming(), resource.data)
          && sourceValuesKept(personAffiliationsVerbatim());
      }
    }

    // Subcollections that members read are read beneath one parent or beneath every parent at
    // once, so their read rules match the collection wherever it sits.
    // Reads: 1 (access).
    match /{path=**}/affiliations/{affiliationId} {
      allow read: if isMember() && boundedRead();
    }

    // An institution is created by an import or by a callable function, which reserves its
    // keys. Imports find it again by its ROR identifier, which the same function changes.
    // Reads: 1 (access).
    match /institutions/{institutionId} {
      function institutionsRequired() { return ['name', 'emailDomains']; }
      function institutionsEditable() {
        return ['name', 'shortName', 'countryCode', 'city', 'website', 'emailDomains'];
      }

      function validInstitution(d) {
        return shortText(d.name)
          && shortText(d.get('shortName', 'x'))
          && d.get('countryCode', 'GB').matches('^[A-Z]{2}$')
          && shortText(d.get('city', 'x'))
          && webAddress(d.get('website', 'https://example.org'))
          && d.emailDomains.size() <= 50
          && strings(d.emailDomains)
          && !('' in d.emailDomains)
          && d.emailDomains.join('\n').matches('^([^\n]{3,253}(\n|$))*$');
      }

      allow read: if isMember() && boundedRead();
      allow update: if isMember() && canForProgramme('lookupsManage')
        && updatedNow(incoming(), stampFields().concat(institutionsEditable()), institutionsRequired())
        && validInstitution(incoming());
    }

    // ===== Programme, laboratories and equipment (section 4) =====

    // Reads: 2 (access, the parent programme).
    match /programmes/{programmeKey} {
      function programmesFields() { return ['key', 'name', 'description', 'parentId', 'kind']; }
      function programmesRequired() { return ['key', 'name', 'parentId', 'kind']; }
      function programmesEditable() { return ['name', 'description', 'parentId', 'kind']; }

      function validProgramme(d) {
        return shortText(d.name)
          && longText(d.get('description', 'x'))
          && d.kind in ['programme', 'subproject']
          && (d.parentId == null
            || (docId(d.parentId) && exists(/databases/$(database)/documents/programmes/$(d.parentId))));
      }

      allow read: if isMember() && boundedRead();
      allow create: if isMember() && canForProgramme('lookupsManage')
        && createdNow(incoming(), programmesFields(), programmesRequired())
        && incoming().key == programmeKey
        && key(programmeKey)
        && validProgramme(incoming());
      allow update: if isMember() && canForProgramme('lookupsManage')
        && updatedNow(incoming(), stampFields().concat(programmesEditable()), programmesRequired())
        && validProgramme(incoming());
    }

    // The one authoritative profile of a laboratory. It is created by an import or by a
    // callable function. Its coordinators maintain it.
    // Reads: 3 (access, and the institution and the person where an update names a new one).
    match /laboratories/{laboratoryId} {
      function laboratoriesRequired() { return ['slug', 'name', 'status', 'custom', 'dataOrigin']; }
      function laboratoriesEditable() {
        return [
          'name', 'institutionId', 'department', 'countryCode', 'city', 'website', 'piPersonId', 'status',
          'description', 'custom'
        ];
      }

      function validLaboratory(d) {
        return shortText(d.name)
          && docId(d.get('institutionId', 'x'))
          && shortText(d.get('department', 'x'))
          && d.get('countryCode', 'GB').matches('^[A-Z]{2}$')
          && shortText(d.get('city', 'x'))
          && webAddress(d.get('website', 'https://example.org'))
          && docId(d.get('piPersonId', 'x'))
          && d.status in ['unverified', 'active', 'inactive']
          && longText(d.get('description', 'x'))
          && customValues(d.custom);
      }

      // A reference that an update introduces points at a document that exists.
      function laboratoryReferencesExist(d, stored) {
        return (!('institutionId' in d)
            || d.institutionId == stored.get('institutionId', null)
            || exists(/databases/$(database)/documents/institutions/$(d.institutionId)))
          && (!('piPersonId' in d)
            || d.piPersonId == stored.get('piPersonId', null)
            || personExists(d.piPersonId));
      }

      allow read: if isMember() && boundedRead();
      allow update: if isMember() && canForLaboratory('labsManage', laboratoryId)
        && updatedNow(incoming(), stampFields().concat(laboratoriesEditable()), laboratoriesRequired())
        && validLaboratory(incoming())
        && laboratoryReferencesExist(incoming(), resource.data);

      // The postal address and the internal notes of the laboratory.
      // Reads: 2 (access, and the laboratory when the document is created).
      match /private/detail {
        function laboratoryDetailFields() { return ['address', 'internalNotes']; }
        function laboratoryDetailRequired() { return []; }
        function laboratoryDetailEditable() { return ['address', 'internalNotes']; }

        function validLaboratoryDetail(d) {
          return d.get('address', '') is string
            && d.get('address', '').size() <= 2000
            && verbatim(d.get('internalNotes', ''));
        }

        allow get: if isMember() && (core() || inLaboratory(laboratoryId));
        allow create: if isMember() && canForLaboratory('labsManage', laboratoryId)
          && laboratoryExists(laboratoryId)
          && createdNow(incoming(), laboratoryDetailFields(), laboratoryDetailRequired())
          && validLaboratoryDetail(incoming());
        allow update: if isMember() && canForLaboratory('labsManage', laboratoryId)
          && updatedNow(incoming(), stampFields().concat(laboratoryDetailEditable()), laboratoryDetailRequired())
          && validLaboratoryDetail(incoming());
      }

      // A directory fact about a person. A confirmed entry lets the coordinators read the
      // contact details of the person and gives the person the scope of the laboratory, so the
      // confirmation covers exactly what was confirmed. An entry starts as proposed, and no
      // client confirms one: the person concerned or an administrator does, through a callable
      // function. A coordinator who changes the role or the mark of an authorised
      // representative of a confirmed entry returns it to proposed with the change, and an
      // archived entry comes back as a proposal. The earlier periods are kept by trusted code.
      // Reads: 3 (access, the laboratory, the person).
      match /members/{personId} {
        function laboratoryMembersFields() {
          return ['laboratoryId', 'personId', 'role', 'isAuthorisedRepresentative', 'startDate', 'endDate', 'earlierPeriods', 'status'];
        }
        function laboratoryMembersRequired() {
          return ['laboratoryId', 'personId', 'role', 'isAuthorisedRepresentative', 'earlierPeriods', 'status'];
        }
        function laboratoryMembersEditable() {
          return ['role', 'isAuthorisedRepresentative', 'startDate', 'endDate', 'status'];
        }

        function validLaboratoryMember(d) {
          return d.role in ['pi', 'coordinator', 'representative', 'member']
            && d.isAuthorisedRepresentative is bool
            && isoDate(d.get('startDate', '2000-01-01'))
            && isoDate(d.get('endDate', '2000-01-01'));
        }

        // The envelope of a change. An archived entry that is put forward again changes its
        // status with its restoration, whoever archived it. Every other change follows the
        // rule of every record: an archived entry is restored as it was by whoever archived
        // it, by programme administrators and by the core team.
        function entryUpdatedNow(d) {
          return resource.data.archivedAt != null && d.status == 'proposed'
            ? (changed().hasOnly(stampFields().concat(['status']))
              && d.archivedAt == null
              && d.updatedAt == request.time
              && d.updatedBy == request.auth.uid
              && d.writeContext == userContext())
            : updatedNow(d, stampFields().concat(laboratoryMembersEditable()), laboratoryMembersRequired());
        }

        // What a confirmation covers, for everyone below the programme: the role and the mark
        // of the entry while it stays confirmed, and its being in force.
        function confirmationKept(d, stored) {
          return canForProgramme('labsManage')
            || d.status != 'confirmed'
            || (stored.archivedAt == null && !changed().hasAny(['role', 'isAuthorisedRepresentative']));
        }

        allow create: if isMember() && canForLaboratory('labsManage', laboratoryId)
          && createdNow(incoming(), laboratoryMembersFields(), laboratoryMembersRequired())
          && incoming().laboratoryId == laboratoryId
          && incoming().personId == personId
          && incoming().status == 'proposed'
          && incoming().earlierPeriods == []
          && validLaboratoryMember(incoming())
          && laboratoryExists(laboratoryId)
          && personExists(personId);
        allow update: if isMember() && canForLaboratory('labsManage', laboratoryId)
          && entryUpdatedNow(incoming())
          && (incoming().status == resource.data.status || incoming().status in ['proposed', 'ended'])
          && confirmationKept(incoming(), resource.data)
          && validLaboratoryMember(incoming());
      }

      // equipment has no write rule: a callable function replaces a configuration, so that
      // each chain keeps exactly one current member.
    }

    // Reads: 1 (access).
    match /{path=**}/members/{personId} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/equipment/{configurationId} {
      allow read: if isMember() && boundedRead();
    }

    // ===== Replications and scientific definition (section 5) =====

    // Its leads maintain the scientific definition of a replication. The status, the leads, the
    // programme it belongs to, its selection, the stage that the public sees, the result of
    // the citation check and the links to vocabulary terms are written by trusted code alone.
    // Reads: 2 (access, the programme).
    match /replications/{studyKey} {
      function replicationsFields() {
        return [
          'programmeId', 'studyKey', 'shortTitle', 'originalAuthors', 'originalYear', 'originalTitle',
          'originalReference', 'originalDoi', 'citationStatus', 'citationCheckedAt', 'citationSource',
          'citationMetadata', 'abstract', 'rationale', 'effectOfInterest', 'plainLanguageDescription', 'originalN',
          'originalNSource', 'originalStatistics', 'originalEffectSizeSource', 'originalEffectSizeValue',
          'originalEffectSizeMetric', 'originalBayesFactorSource', 'powerAssumptions', 'powerBasedN',
          'powerBasedNSource', 'targetN', 'durationSource', 'sampleType', 'minEegChannels', 'minEegChannelsSource',
          'extraEquipment', 'studyType', 'outcome', 'psychConstruct', 'theme', 'statusKey', 'statusHistoryId',
          'publicStageNumber', 'publicStageName', 'publicStageText', 'signupUrl', 'signupActive', 'selectionStatus',
          'leadPersonIds', 'vocabulary', 'custom', 'dataOrigin'
        ];
      }
      function replicationsRequired() {
        return [
          'programmeId', 'studyKey', 'citationStatus', 'statusKey', 'statusHistoryId', 'selectionStatus',
          'leadPersonIds', 'vocabulary', 'custom', 'dataOrigin'
        ];
      }
      function replicationsEditable() {
        return [
          'shortTitle', 'originalAuthors', 'originalYear', 'originalTitle', 'originalReference', 'originalDoi',
          'abstract', 'rationale', 'effectOfInterest', 'plainLanguageDescription', 'originalN', 'originalNSource',
          'originalStatistics', 'originalEffectSizeSource', 'originalEffectSizeValue', 'originalEffectSizeMetric',
          'originalBayesFactorSource', 'powerAssumptions', 'powerBasedN', 'powerBasedNSource', 'targetN',
          'durationSource', 'sampleType', 'minEegChannels', 'minEegChannelsSource', 'extraEquipment', 'studyType',
          'outcome', 'psychConstruct', 'theme', 'signupUrl', 'signupActive', 'custom'
        ];
      }
      function replicationsVerbatim() {
        return [
          'originalNSource', 'originalEffectSizeSource', 'originalBayesFactorSource', 'powerBasedNSource',
          'durationSource', 'minEegChannelsSource'
        ];
      }

      // A new replication holds its identity and nothing else: the programme, the study
      // identifier and a short title. Everything that is reserved for trusted code starts empty
      // or at its first value, and the scientific definition is written afterwards, by changes
      // that are checked field by field. One request could not afford both checks.
      function startsEmpty(d) {
        return d.keys().hasOnly(standardFields().concat(replicationsRequired()).concat(['shortTitle']))
          && d.statusKey == null
          && d.statusHistoryId == null
          && d.leadPersonIds == []
          && d.selectionStatus == 'selected'
          && d.citationStatus == 'unverified'
          && d.vocabulary == []
          && d.custom == {}
          && shortText(d.get('shortTitle', 'x'));
      }

      function validOriginalStudy(d) {
        return shortText(d.get('shortTitle', 'x'))
          && longText(d.get('originalAuthors', 'x'))
          && year(d.get('originalYear', 2000))
          && longText(d.get('originalTitle', 'x'))
          && longText(d.get('originalReference', 'x'))
          && doi(d.get('originalDoi', '10.1000/x'))
          && count(d.get('originalN', 0), 10000000)
          && verbatim(d.get('originalNSource', ''))
          && longText(d.get('originalStatistics', 'x'))
          && verbatim(d.get('originalEffectSizeSource', ''))
          && d.get('originalEffectSizeValue', 0) is number
          && shortText(d.get('originalEffectSizeMetric', 'x'))
          && verbatim(d.get('originalBayesFactorSource', ''));
      }

      function validDesign(d) {
        return richText(d.get('abstract', ''))
          && richText(d.get('rationale', ''))
          && longText(d.get('effectOfInterest', 'x'))
          && richText(d.get('plainLanguageDescription', ''))
          && longText(d.get('powerAssumptions', 'x'))
          && count(d.get('powerBasedN', 0), 10000000)
          && verbatim(d.get('powerBasedNSource', ''))
          && count(d.get('targetN', 0), 10000000)
          && verbatim(d.get('durationSource', ''))
          && shortText(d.get('sampleType', 'x'))
          && count(d.get('minEegChannels', 0), 10000000)
          && verbatim(d.get('minEegChannelsSource', ''))
          && longText(d.get('extraEquipment', 'x'));
      }

      function validReplication(d) {
        return validOriginalStudy(d)
          && validDesign(d)
          && shortText(d.get('studyType', 'x'))
          && longText(d.get('outcome', 'x'))
          && shortText(d.get('psychConstruct', 'x'))
          && shortText(d.get('theme', 'x'))
          && webAddress(d.get('signupUrl', 'https://example.org'))
          && d.get('signupActive', false) is bool
          && customValues(d.custom);
      }

      allow read: if isMember() && boundedRead();
      // A replication is created by programme administrators and the core team.
      allow create: if isMember() && canForProgramme('replicationsManage')
        && createdNow(incoming(), replicationsFields(), replicationsRequired())
        && incoming().studyKey == studyKey
        && studyKey.matches('^[A-Za-z][A-Za-z0-9]{0,99}$')
        && startsEmpty(incoming())
        && incoming().dataOrigin == 'live'
        && docId(incoming().programmeId)
        && exists(/databases/$(database)/documents/programmes/$(incoming().programmeId));
      allow update: if isMember() && canForReplication('replicationsManage', studyKey)
        && updatedNow(incoming(), stampFields().concat(replicationsEditable()), replicationsRequired())
        && sourceValuesKept(replicationsVerbatim())
        && validReplication(incoming());

      // Restricted notes. A client writes `internalNotes` alone: the verbatim notes of a
      // source and the unverified outcome labels belong to the importers.
      // Reads: 2 (access, the replication).
      match /private/detail {
        function replicationDetailRequired() { return []; }
        function replicationDetailEditableByReplicationLead() { return ['internalNotes']; }

        allow get: if isMember() && (core() || onTeam(studyKey));
        allow create: if isMember() && canForReplication('replicationsManage', studyKey)
          && replicationExists(studyKey)
          && createdNow(incoming(), replicationDetailEditableByReplicationLead(), replicationDetailRequired())
          && verbatim(incoming().get('internalNotes', ''));
        allow update: if isMember() && canForReplication('replicationsManage', studyKey)
          && updatedNow(
            incoming(),
            touchFields().concat(replicationDetailEditableByReplicationLead()),
            replicationDetailRequired()
          )
          && verbatim(incoming().get('internalNotes', ''));
      }

      // A record about a person, which grants nothing by itself. A current, confirmed
      // membership gives read scope and sight of contact details, so only programme
      // administrators and the core team write the roles lead and coLead or set `reviewStatus`.
      // A lead proposes any other membership, which starts as needsReview, and ends or archives
      // one. A confirmation covers the period that was confirmed: a lead neither makes a
      // confirmed membership current again nor restores one from the archive. The earlier
      // periods are kept by trusted code.
      // Reads: 3 (access, the replication, the person).
      match /memberships/{membershipId} {
        function replicationMembershipsFields() {
          return ['replicationId', 'personId', 'role', 'isCurrent', 'startDate', 'endDate', 'earlierPeriods', 'reviewStatus'];
        }
        function replicationMembershipsRequired() {
          return ['replicationId', 'personId', 'role', 'isCurrent', 'earlierPeriods', 'reviewStatus'];
        }
        function replicationMembershipsEditable() {
          return ['isCurrent', 'startDate', 'endDate', 'reviewStatus'];
        }

        function leadsWithTheCapability() {
          return ('rep:' + studyKey) in heldFor('replicationsManage');
        }

        function validMembership(d) {
          return d.role in ['lead', 'coLead', 'formerLead', 'coordinator', 'analyst', 'member', 'advisor']
            && d.reviewStatus in ['confirmed', 'needsReview']
            && d.isCurrent is bool
            && isoDate(d.get('startDate', '2000-01-01'))
            && isoDate(d.get('endDate', '2000-01-01'));
        }

        function confirmationKept(d, stored) {
          return stored.reviewStatus != 'confirmed'
            || (stored.archivedAt == null && (d.isCurrent == stored.isCurrent || d.isCurrent == false));
        }

        allow create: if isMember()
          && (canForProgramme('replicationsManage')
            || (leadsWithTheCapability()
              && !(incoming().role in ['lead', 'coLead'])
              && incoming().reviewStatus == 'needsReview'))
          && createdNow(incoming(), replicationMembershipsFields(), replicationMembershipsRequired())
          && incoming().replicationId == studyKey
          && membershipId == incoming().personId + '__' + incoming().role
          && incoming().earlierPeriods == []
          && validMembership(incoming())
          && replicationExists(studyKey)
          && personExists(incoming().personId);
        allow update: if isMember()
          && (canForProgramme('replicationsManage')
            || (leadsWithTheCapability()
              && !(resource.data.role in ['lead', 'coLead'])
              && incoming().reviewStatus == resource.data.reviewStatus
              && confirmationKept(incoming(), resource.data)))
          && updatedNow(
            incoming(),
            stampFields().concat(replicationMembershipsEditable()),
            replicationMembershipsRequired()
          )
          && validMembership(incoming());
      }

      // A hypothesis and its result. The review of a result is a signature: it names its
      // reviewer and the instant of the review, and it covers the content of the hypothesis.
      // Programme administrators and the core team review. Whoever of them changes the content
      // clears the review or signs it anew, so a review never stays on something its reviewer
      // did not see. A lead writes the content until it is reviewed or verified, and neither
      // sets the review status nor the review, because a lead does not review its own result.
      // Reads: 2 (access, the replication).
      match /hypotheses/{hypothesisId} {
        function replicationHypothesesFields() {
          return [
            'replicationId', 'hypothesisNumber', 'text', 'expectedEffect', 'outcomeMeasure', 'analysisSpecification',
            'preregistrationUrl', 'originalStatistics', 'nullSigSource', 'scientificReviewStatus', 'analysisStatus',
            'resultSummary', 'resultReviewedBy', 'resultReviewedAt', 'studyDescriptionUrl', 'infosheetUrl'
          ];
        }
        function replicationHypothesesRequired() {
          return [
            'replicationId', 'hypothesisNumber', 'text', 'scientificReviewStatus', 'analysisStatus',
            'resultReviewedBy', 'resultReviewedAt'
          ];
        }
        function replicationHypothesesEditable() {
          return [
            'text', 'expectedEffect', 'outcomeMeasure', 'analysisSpecification', 'preregistrationUrl',
            'originalStatistics', 'nullSigSource', 'scientificReviewStatus', 'analysisStatus', 'resultSummary',
            'resultReviewedBy', 'resultReviewedAt', 'studyDescriptionUrl', 'infosheetUrl'
          ];
        }
        function replicationHypothesesEditableByReplicationLead() {
          return [
            'text', 'expectedEffect', 'outcomeMeasure', 'analysisSpecification', 'preregistrationUrl',
            'originalStatistics', 'nullSigSource', 'analysisStatus', 'resultSummary', 'studyDescriptionUrl',
            'infosheetUrl', 'archivedAt'
          ];
        }
        function replicationHypothesesVerbatim() { return ['nullSigSource']; }

        // What a review covers.
        function reviewedContent() {
          return [
            'text', 'expectedEffect', 'outcomeMeasure', 'analysisSpecification', 'originalStatistics',
            'nullSigSource', 'scientificReviewStatus', 'analysisStatus', 'resultSummary'
          ];
        }

        function leadsWithTheCapability() {
          return ('rep:' + studyKey) in heldFor('replicationsManage');
        }

        function validHypothesis(d) {
          return richText(d.text)
            && longText(d.get('expectedEffect', 'x'))
            && longText(d.get('outcomeMeasure', 'x'))
            && richText(d.get('analysisSpecification', ''))
            && webAddress(d.get('preregistrationUrl', 'https://example.org'))
            && longText(d.get('originalStatistics', 'x'))
            && verbatim(d.get('nullSigSource', ''))
            && d.scientificReviewStatus in ['unverified', 'underReview', 'verified']
            && d.analysisStatus in ['notStarted', 'inProgress', 'completed']
            && richText(d.get('resultSummary', ''))
            && webAddress(d.get('studyDescriptionUrl', 'https://example.org'))
            && webAddress(d.get('infosheetUrl', 'https://example.org'));
        }

        // The review after a change by a reviewer.
        function reviewKept(d, stored) {
          return changed().hasAny(reviewedContent())
            ? signedNowOrNot(d.resultReviewedBy, d.resultReviewedAt)
            : namesCallerNow(d.resultReviewedBy, d.resultReviewedAt, stored.resultReviewedBy, stored.resultReviewedAt);
        }

        // Whether a lead may still change the content: nobody has reviewed or verified it.
        function openToItsLead(stored) {
          return (stored.resultReviewedBy == null && stored.scientificReviewStatus != 'verified')
            || changed().hasOnly(touchFields().concat(['preregistrationUrl', 'studyDescriptionUrl', 'infosheetUrl']));
        }

        // The identifier is `h` and the two-digit number of the hypothesis, as `hypothesisId`
        // of the shared package builds it, and `hypothesisNumber` is that number as written.
        allow create: if isMember()
          && (canForProgramme('replicationsManage')
            ? signedNowOrNot(incoming().resultReviewedBy, incoming().resultReviewedAt)
            : (leadsWithTheCapability()
              && incoming().scientificReviewStatus == 'unverified'
              && incoming().resultReviewedBy == null
              && incoming().resultReviewedAt == null))
          && createdNow(incoming(), replicationHypothesesFields(), replicationHypothesesRequired())
          && incoming().replicationId == studyKey
          && hypothesisId.matches('^h(0[1-9]|[1-9][0-9])$')
          && incoming().hypothesisNumber == (hypothesisId[1:2] == '0' ? hypothesisId[2:3] : hypothesisId[1:3])
          && validHypothesis(incoming())
          && replicationExists(studyKey);
        allow update: if isMember()
          && (canForProgramme('replicationsManage')
            ? (updatedNow(
                incoming(),
                stampFields().concat(replicationHypothesesEditable()),
                replicationHypothesesRequired()
              )
              && reviewKept(incoming(), resource.data))
            : (leadsWithTheCapability()
              && updatedNow(
                incoming(),
                touchFields().concat(replicationHypothesesEditableByReplicationLead()),
                replicationHypothesesRequired()
              )
              && openToItsLead(resource.data)))
          && sourceValuesKept(replicationHypothesesVerbatim())
          && validHypothesis(incoming());
      }

      // Reads: 3 (access, the replication when the protocol is created, the version that an
      // update names as current).
      match /protocols/{protocolId} {
        function replicationProtocolsFields() { return ['replicationId', 'title', 'description', 'currentVersionId']; }
        function replicationProtocolsRequired() { return ['replicationId', 'title', 'currentVersionId']; }
        function replicationProtocolsEditable() { return ['title', 'description', 'currentVersionId']; }

        function validProtocol(d) {
          return shortText(d.title) && longText(d.get('description', 'x'));
        }

        // The current version of a protocol is one of its own versions.
        function currentVersionNamed(d, stored) {
          return d.currentVersionId == null
            || d.currentVersionId == stored.currentVersionId
            || (docId(d.currentVersionId)
              && get(/databases/$(database)/documents/replications/$(studyKey)/protocolVersions/$(d.currentVersionId)).data.protocolId == protocolId);
        }

        // A version names its protocol, so a new protocol has none yet.
        allow create: if isMember() && canForReplication('replicationsManage', studyKey)
          && autoId(protocolId)
          && createdNow(incoming(), replicationProtocolsFields(), replicationProtocolsRequired())
          && incoming().replicationId == studyKey
          && incoming().currentVersionId == null
          && validProtocol(incoming())
          && replicationExists(studyKey);
        allow update: if isMember() && canForReplication('replicationsManage', studyKey)
          && updatedNow(incoming(), stampFields().concat(replicationProtocolsEditable()), replicationProtocolsRequired())
          && validProtocol(incoming())
          && currentVersionNamed(incoming(), resource.data);
      }

      // One version of a protocol. Its approval is a signature: a draft names no approver, and
      // whoever approves a version names itself at the request time. People acknowledge an
      // approved version, so it changes no more: it becomes superseded, and a superseded
      // version stays as it is.
      // Reads: 3 (access, the protocol when the version is created, the document link that a
      // write introduces).
      match /protocolVersions/{versionId} {
        function replicationProtocolVersionsFields() {
          return [
            'replicationId', 'protocolId', 'versionLabel', 'effectiveDate', 'status', 'changeSummary',
            'documentLinkId', 'approvedBy', 'approvedAt'
          ];
        }
        function replicationProtocolVersionsRequired() {
          return ['replicationId', 'protocolId', 'versionLabel', 'status', 'approvedBy', 'approvedAt'];
        }
        function replicationProtocolVersionsEditable() {
          return [
            'protocolId', 'versionLabel', 'effectiveDate', 'status', 'changeSummary', 'documentLinkId',
            'approvedBy', 'approvedAt'
          ];
        }

        function validProtocolVersion(d) {
          return shortText(d.versionLabel)
            && isoDate(d.get('effectiveDate', '2000-01-01'))
            && d.status in ['draft', 'approved', 'superseded']
            && longText(d.get('changeSummary', 'x'))
            && docId(d.get('documentLinkId', 'x'));
        }

        // A document link that a write introduces is a link of this replication.
        function linkNamed(d, stored) {
          return !('documentLinkId' in d)
            || d.documentLinkId == stored.get('documentLinkId', null)
            || get(/databases/$(database)/documents/documentLinks/$(d.documentLinkId)).data.replicationId == studyKey;
        }

        // The signature of a version that is a draft before the write, or new.
        function approvalOfDraft(d) {
          return d.status == 'approved'
            ? (d.approvedBy == request.auth.uid && d.approvedAt == request.time)
            : (d.approvedBy == null && d.approvedAt == null);
        }

        function approvalKept(d, stored) {
          return stored.status == 'draft'
            ? approvalOfDraft(d)
            : (changed().hasOnly(stampFields().concat(['status']))
              && (d.status == stored.status || (stored.status == 'approved' && d.status == 'superseded')));
        }

        allow create: if isMember() && canForReplication('replicationsManage', studyKey)
          && autoId(versionId)
          && createdNow(incoming(), replicationProtocolVersionsFields(), replicationProtocolVersionsRequired())
          && incoming().replicationId == studyKey
          && incoming().status in ['draft', 'approved']
          && approvalOfDraft(incoming())
          && validProtocolVersion(incoming())
          && docId(incoming().protocolId)
          && exists(/databases/$(database)/documents/replications/$(studyKey)/protocols/$(incoming().protocolId))
          && linkNamed(incoming(), {});
        // A version stays with its protocol.
        allow update: if isMember() && canForReplication('replicationsManage', studyKey)
          && updatedNow(
            incoming(),
            stampFields().concat(replicationProtocolVersionsEditable()),
            replicationProtocolVersionsRequired()
          )
          && incoming().protocolId == resource.data.protocolId
          && approvalKept(incoming(), resource.data)
          && validProtocolVersion(incoming())
          && linkNamed(incoming(), resource.data);
      }

      // Reads: 2 (access, the replication).
      match /equipmentRequirements/{requirementKey} {
        function replicationEquipmentRequirementsFields() {
          return ['replicationId', 'requirementKey', 'operator', 'value', 'isMandatory', 'note'];
        }
        function replicationEquipmentRequirementsRequired() {
          return ['replicationId', 'requirementKey', 'operator', 'isMandatory'];
        }
        function replicationEquipmentRequirementsEditable() { return ['operator', 'value', 'isMandatory', 'note']; }

        function validRequirement(d) {
          return d.operator in ['equals', 'atLeast', 'atMost', 'includes', 'present']
            && d.isMandatory is bool
            && (!('value' in d)
              || d.value is bool
              || d.value is number
              || (d.value is string && d.value.size() <= 300))
            && longText(d.get('note', 'x'));
        }

        allow create: if isMember() && canForReplication('replicationsManage', studyKey)
          && createdNow(
            incoming(),
            replicationEquipmentRequirementsFields(),
            replicationEquipmentRequirementsRequired()
          )
          && incoming().replicationId == studyKey
          && incoming().requirementKey == requirementKey
          && key(requirementKey)
          && validRequirement(incoming())
          && replicationExists(studyKey);
        allow update: if isMember() && canForReplication('replicationsManage', studyKey)
          && updatedNow(
            incoming(),
            stampFields().concat(replicationEquipmentRequirementsEditable()),
            replicationEquipmentRequirementsRequired()
          )
          && validRequirement(incoming());
      }

      // aliases and summaries have no write rule: trusted code derives them.
    }

    // Every member reads a confirmed membership. The others are read within the scope of the
    // replication, so a member's list query asks for the confirmed ones, or names a
    // replication the caller belongs to.
    // Reads: 1 (access).
    match /{path=**}/memberships/{membershipId} {
      allow read: if isMember()
        && (resource.data.reviewStatus == 'confirmed' || core() || onTeam(resource.data.replicationId))
        && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/aliases/{aliasId} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/hypotheses/{hypothesisId} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/protocols/{protocolId} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/protocolVersions/{versionId} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/equipmentRequirements/{requirementKey} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/summaries/{kind} {
      allow read: if isMember() && boundedRead();
    }

    // One change of status, read as the record whose status it records: its scope keys hold
    // `members` where every member reads that record. Written by the callable function that
    // changes the status, in the same transaction.
    // Reads: 1 (access).
    match /statusHistory/{entryId} {
      allow read: if isMember() && (core() || holdsScopeOf(resource.data)) && boundedRead();
    }

    // Reads: 1 (access).
    match /historicalAggregates/{aggregateId} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 2 (access, the programme).
    match /candidateStudies/{candidateId} {
      function candidateStudiesFields() {
        return [
          'programmeId', 'originalAuthors', 'originalYear', 'originalTitle', 'originalReference', 'originalDoi',
          'selectionStatus', 'replicationId', 'dataOrigin'
        ];
      }
      function candidateStudiesRequired() { return ['programmeId', 'selectionStatus', 'replicationId', 'dataOrigin']; }
      function candidateStudiesEditable() {
        return ['programmeId', 'originalAuthors', 'originalYear', 'originalTitle', 'originalReference', 'selectionStatus'];
      }

      function validCandidate(d) {
        return longText(d.get('originalAuthors', 'x'))
          && year(d.get('originalYear', 2000))
          && longText(d.get('originalTitle', 'x'))
          && longText(d.get('originalReference', 'x'))
          && doi(d.get('originalDoi', '10.1000/x'))
          && d.selectionStatus in ['shortlisted', 'rankedCandidate', 'selected', 'withdrawn'];
      }

      // The programme that a write names exists.
      function programmeNamed(d, stored) {
        return d.programmeId == stored.get('programmeId', null)
          || (docId(d.programmeId) && exists(/databases/$(database)/documents/programmes/$(d.programmeId)));
      }

      allow read: if isMember() && boundedRead();
      // Trusted code links a candidate to the replication it has become.
      allow create: if isMember() && canForProgramme('replicationsManage')
        && createdNow(incoming(), candidateStudiesFields(), candidateStudiesRequired())
        && docId(candidateId)
        && validCandidate(incoming())
        && incoming().replicationId == null
        && incoming().dataOrigin == 'live'
        && programmeNamed(incoming(), {});
      allow update: if isMember() && canForProgramme('replicationsManage')
        && updatedNow(incoming(), stampFields().concat(candidateStudiesEditable()), candidateStudiesRequired())
        && validCandidate(incoming())
        && programmeNamed(incoming(), resource.data);
    }

    // Reads: 1 (access).
    match /studyAliasIndex/{foldedAlias} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 1 (access).
    match /statusDefinitions/{definitionId} {
      function statusDefinitionsFields() { return ['entityType', 'key', 'label', 'category', 'position', 'isDefault']; }
      function statusDefinitionsRequired() { return ['entityType', 'key', 'label', 'category', 'position', 'isDefault']; }
      function statusDefinitionsEditable() { return ['label', 'category', 'position', 'isDefault']; }

      function validStatusDefinition(d) {
        return shortText(d.label)
          && d.category in ['notStarted', 'active', 'done', 'paused', 'cancelled']
          && d.position is int
          && d.position >= 0
          && d.isDefault is bool;
      }

      allow read: if isMember() && boundedRead();
      allow create: if isMember() && canForProgramme('lookupsManage')
        && createdNow(incoming(), statusDefinitionsFields(), statusDefinitionsRequired())
        && incoming().entityType in ['replication', 'participation', 'dataset', 'task', 'manuscript']
        && key(incoming().key)
        && definitionId == incoming().entityType + '__' + incoming().key
        && validStatusDefinition(incoming());
      allow update: if isMember() && canForProgramme('lookupsManage')
        && updatedNow(incoming(), stampFields().concat(statusDefinitionsEditable()), statusDefinitionsRequired())
        && validStatusDefinition(incoming());
    }

    // A term keeps the identifier that its source gave it, which only an import sets.
    // Reads: 1 (access).
    match /vocabularyTerms/{termId} {
      function vocabularyTermsFields() {
        return [
          'sourceId', 'name', 'abbreviation', 'description', 'invalidReason', 'sameAsSource', 'labelsSource', 'kind',
          'isDeprecated'
        ];
      }
      function vocabularyTermsRequired() { return ['name', 'sameAsSource', 'labelsSource', 'kind', 'isDeprecated']; }
      function vocabularyTermsEditable() {
        return ['abbreviation', 'description', 'invalidReason', 'sameAsSource', 'labelsSource', 'isDeprecated'];
      }
      function vocabularyTermsVerbatim() { return ['sameAsSource', 'labelsSource']; }

      function validTerm(d) {
        return shortText(d.get('abbreviation', 'x'))
          && longText(d.get('description', 'x'))
          && longText(d.get('invalidReason', 'x'))
          && verbatims(d.sameAsSource)
          && verbatims(d.labelsSource)
          && d.isDeprecated is bool;
      }

      allow read: if isMember() && boundedRead();
      allow create: if isMember() && canForProgramme('lookupsManage')
        && createdNow(incoming(), vocabularyTermsFields(), vocabularyTermsRequired())
        && docId(termId)
        && !('sourceId' in incoming())
        && shortText(incoming().name)
        && key(incoming().kind)
        && validTerm(incoming());
      allow update: if isMember() && canForProgramme('lookupsManage')
        && updatedNow(incoming(), stampFields().concat(vocabularyTermsEditable()), vocabularyTermsRequired())
        && sourceValuesKept(vocabularyTermsVerbatim())
        && validTerm(incoming());
    }

    // Reads: 3 (access, the replication and the hypothesis of a question about one).
    match /predictionMarketItems/{itemId} {
      function predictionMarketItemsFields() { return ['replicationId', 'hypothesisId', 'questionText', 'choices']; }
      function predictionMarketItemsRequired() { return ['questionText', 'choices']; }
      function predictionMarketItemsEditable() { return ['hypothesisId', 'questionText', 'choices']; }

      function validQuestion(d) {
        return longText(d.questionText) && shortTexts(d.choices, 50);
      }

      // A question names a hypothesis only together with its replication, and the hypothesis
      // is one of that replication.
      function hypothesisNamed(d) {
        return !('hypothesisId' in d)
          || (docId(d.hypothesisId)
            && docId(d.replicationId)
            && exists(/databases/$(database)/documents/replications/$(d.replicationId)/hypotheses/$(d.hypothesisId)));
      }

      allow read: if isMember() && boundedRead();
      allow create: if isMember() && canForProgramme('replicationsManage')
        && autoId(itemId)
        && createdNow(incoming(), predictionMarketItemsFields(), predictionMarketItemsRequired())
        && validQuestion(incoming())
        && (!('replicationId' in incoming())
          || (docId(incoming().replicationId) && replicationExists(incoming().replicationId)))
        && hypothesisNamed(incoming());
      allow update: if isMember() && canForProgramme('replicationsManage')
        && updatedNow(incoming(), stampFields().concat(predictionMarketItemsEditable()), predictionMarketItemsRequired())
        && validQuestion(incoming())
        && (!changed().hasAny(['hypothesisId']) || hypothesisNamed(incoming()));
    }

    // ===== Participation (section 6) =====

    // Everything specific to one laboratory in one replication. The leads of the replication
    // and the coordinators of the laboratory manage it, and each side records its own
    // decision: the replication invites a laboratory, and the laboratory registers its
    // interest. The laboratory puts its readiness forward and the replication approves it.
    // `status` and `statusHistoryId` change through a callable function, which writes the
    // history entry in the same transaction.
    // Reads: 7 on creation (access, the replication, the laboratory, and the local lead, the
    // protocol, the protocol version and the equipment configuration where it names them), and
    // 5 on an update that introduces all four references.
    match /participations/{participationId} {
      function participationsFields() {
        return [
          'replicationId', 'laboratoryId', 'scopeKeys', 'localLeadPersonId', 'status', 'statusHistoryId',
          'targetNMain', 'targetNRest', 'protocolId', 'protocolVersionId', 'equipmentConfigurationId', 'signedUpAt',
          'readinessStatus', 'custom', 'dataOrigin'
        ];
      }
      function participationsRequired() {
        return [
          'replicationId', 'laboratoryId', 'scopeKeys', 'status', 'statusHistoryId', 'readinessStatus', 'custom',
          'dataOrigin'
        ];
      }
      function participationsEditable() {
        return [
          'localLeadPersonId', 'targetNMain', 'targetNRest', 'protocolId', 'protocolVersionId',
          'equipmentConfigurationId', 'signedUpAt', 'readinessStatus', 'custom'
        ];
      }

      function validParticipation(d) {
        return docId(d.get('localLeadPersonId', 'x'))
          && count(d.get('targetNMain', 0), 1000000)
          && count(d.get('targetNRest', 0), 1000000)
          && docId(d.get('protocolId', 'x'))
          && docId(d.get('protocolVersionId', 'x'))
          && docId(d.get('equipmentConfigurationId', 'x'))
          && d.get('signedUpAt', request.time) is timestamp
          && d.readinessStatus in ['notStarted', 'inProgress', 'readyForReview', 'approved']
          && customValues(d.custom);
      }

      // A reference that a write introduces points at a document that exists: a person, a
      // protocol of the replication and a configuration of the laboratory. A protocol version
      // is a version of the protocol that the participation names, so the pair is checked
      // whenever either of the two changes.
      function participationReferencesExist(d, stored) {
        return (!('localLeadPersonId' in d)
            || d.localLeadPersonId == stored.get('localLeadPersonId', null)
            || personExists(d.localLeadPersonId))
          && (!('protocolId' in d)
            || d.protocolId == stored.get('protocolId', null)
            || exists(/databases/$(database)/documents/replications/$(d.replicationId)/protocols/$(d.protocolId)))
          && (!('protocolVersionId' in d)
            || (d.protocolVersionId == stored.get('protocolVersionId', null)
              && d.get('protocolId', null) == stored.get('protocolId', null))
            || get(/databases/$(database)/documents/replications/$(d.replicationId)/protocolVersions/$(d.protocolVersionId)).data.protocolId == d.protocolId)
          && (!('equipmentConfigurationId' in d)
            || d.equipmentConfigurationId == stored.get('equipmentConfigurationId', null)
            || exists(/databases/$(database)/documents/laboratories/$(d.laboratoryId)/equipment/$(d.equipmentConfigurationId)));
      }

      // Whoever speaks for the replication of a participation: its leads, programme
      // administrators and the core team.
      function forReplication(replicationId) {
        return canForReplication('participationsManage', replicationId);
      }

      allow read: if isMember() && boundedRead();
      // The identifier joins the replication and the laboratory, so the pair exists once. A
      // study identifier holds letters and digits only, which keeps the join unambiguous. A
      // participation starts as invited, which the replication says, or as interested, which
      // the laboratory says, with no status history and with its readiness not started.
      allow create: if isMember()
        && ((incoming().status == 'invited' && forReplication(incoming().replicationId))
          || (incoming().status == 'interested'
            && canForLaboratory('participationsManage', incoming().laboratoryId)))
        && createdNow(incoming(), participationsFields(), participationsRequired())
        && incoming().replicationId.matches('^[A-Za-z][A-Za-z0-9]{0,99}$')
        && docId(incoming().laboratoryId)
        && participationId == incoming().replicationId + '__' + incoming().laboratoryId
        && incoming().scopeKeys == ['rep:' + incoming().replicationId, 'lab:' + incoming().laboratoryId]
        && incoming().statusHistoryId == null
        && incoming().readinessStatus == 'notStarted'
        && incoming().dataOrigin == 'live'
        && validParticipation(incoming())
        && replicationExists(incoming().replicationId)
        && laboratoryExists(incoming().laboratoryId)
        && participationReferencesExist(incoming(), {});
      // Readiness becomes approved, and stops being approved, through the replication alone.
      allow update: if isMember()
        && canForUnit('participationsManage', resource.data.replicationId, resource.data.laboratoryId)
        && updatedNow(incoming(), stampFields().concat(participationsEditable()), participationsRequired())
        && (incoming().readinessStatus == resource.data.readinessStatus
          || (incoming().readinessStatus != 'approved' && resource.data.readinessStatus != 'approved')
          || forReplication(resource.data.replicationId))
        && validParticipation(incoming())
        && participationReferencesExist(incoming(), resource.data);

      // Ethics, training, readiness approval and notes. The approval of readiness is a
      // signature of the replication: only its leads, programme administrators and the core
      // team set it or clear it, in their own name at the request time. It covers ethics,
      // training and the equipment override, so once readiness is approved those change only
      // together with the approval, which is cleared or signed anew.
      // Reads: 2 (access, the participation).
      match /private/detail {
        function participationDetailFields() {
          return [
            'ethicsStatus', 'ethicsReference', 'ethicsApprovedAt', 'trainingStatus', 'readinessApprovedBy',
            'readinessApprovedAt', 'equipmentOverrideJustification', 'notes'
          ];
        }
        function participationDetailRequired() {
          return ['ethicsStatus', 'trainingStatus', 'readinessApprovedBy', 'readinessApprovedAt'];
        }
        function participationDetailEditable() {
          return [
            'ethicsStatus', 'ethicsReference', 'ethicsApprovedAt', 'trainingStatus', 'readinessApprovedBy',
            'readinessApprovedAt', 'equipmentOverrideJustification', 'notes'
          ];
        }

        // What the approval of readiness covers.
        function approvedContent() {
          return ['ethicsStatus', 'ethicsReference', 'ethicsApprovedAt', 'trainingStatus', 'equipmentOverrideJustification'];
        }

        function validParticipationDetail(d) {
          return d.ethicsStatus in ['unknown', 'notStarted', 'submitted', 'approved', 'notRequired']
            && shortText(d.get('ethicsReference', 'x'))
            && d.get('ethicsApprovedAt', request.time) is timestamp
            && d.trainingStatus in ['unknown', 'notStarted', 'inProgress', 'completed', 'notRequired']
            && longText(d.get('equipmentOverrideJustification', 'x'))
            && verbatim(d.get('notes', ''));
        }

        function approvalKept(d, stored) {
          return changed().hasAny(['readinessApprovedBy', 'readinessApprovedAt'])
            ? (forReplication(participation(participationId).replicationId)
              && signedNowOrNot(d.readinessApprovedBy, d.readinessApprovedAt))
            : (stored.readinessApprovedBy == null || !changed().hasAny(approvedContent()));
        }

        allow get: if isMember() && (core() || withinUnit(participation(participationId)));
        allow create: if isMember()
          && participationDocument(participationId) != null
          && canForUnit(
            'participationsManage',
            participation(participationId).replicationId,
            participation(participationId).laboratoryId
          )
          && createdNow(incoming(), participationDetailFields(), participationDetailRequired())
          && ((incoming().readinessApprovedBy == null && incoming().readinessApprovedAt == null)
            || (forReplication(participation(participationId).replicationId)
              && incoming().readinessApprovedBy == request.auth.uid
              && incoming().readinessApprovedAt == request.time))
          && validParticipationDetail(incoming());
        allow update: if isMember()
          && canForUnit(
            'participationsManage',
            participation(participationId).replicationId,
            participation(participationId).laboratoryId
          )
          && updatedNow(incoming(), stampFields().concat(participationDetailEditable()), participationDetailRequired())
          && approvalKept(incoming(), resource.data)
          && validParticipationDetail(incoming());
      }

      // The scope fields of a document beneath a participation are those of the participation.
      function inheritsScope(d) {
        return d.participationId == participationId
          && d.replicationId == participation(participationId).replicationId
          && d.laboratoryId == participation(participationId).laboratoryId
          && d.scopeKeys == ['rep:' + d.replicationId, 'lab:' + d.laboratoryId];
      }

      // An item of the onboarding checklist. A function creates the items from the template.
      // Those who manage the participation update an item, and the members of its laboratory
      // update its status, its evidence and its note. The completion of an item is a
      // signature: an item is done exactly while it names who completed it and when. Whoever
      // changes a completed item signs it anew, or reopens it, and a member of the laboratory
      // reopens only what that member completed.
      // Reads: 1 (access).
      match /checklist/{itemKey} {
        function participationChecklistRequired() {
          return [
            'participationId', 'templateKey', 'templateItemKey', 'label', 'status', 'completedBy', 'completedAt',
            'position', 'replicationId', 'laboratoryId', 'scopeKeys'
          ];
        }
        function participationChecklistEditable() {
          return ['participationId', 'status', 'completedBy', 'completedAt', 'evidenceUrl', 'note'];
        }
        function participationChecklistEditableByLabMember() {
          return ['status', 'completedBy', 'completedAt', 'evidenceUrl', 'note'];
        }

        function validChecklistItem(d, stored) {
          return d.status in ['notStarted', 'inProgress', 'done', 'notApplicable', 'blocked']
            && (d.status == 'done') == (d.completedBy != null)
            && namesCallerNow(d.completedBy, d.completedAt, stored.completedBy, stored.completedAt)
            && webAddress(d.get('evidenceUrl', 'https://example.org'))
            && longText(d.get('note', 'x'));
        }

        function completionKept(d, stored, manages) {
          return stored.status != 'done'
            || !changed().hasAny(['status', 'completedBy', 'completedAt', 'evidenceUrl', 'note'])
            || (d.completedBy == request.auth.uid && d.completedAt == request.time)
            || (d.status != 'done' && (manages || stored.completedBy == request.auth.uid));
        }

        allow update: if isMember()
          && ((canForUnit('participationsManage', resource.data.replicationId, resource.data.laboratoryId)
              && updatedNow(
                incoming(),
                stampFields().concat(participationChecklistEditable()),
                participationChecklistRequired()
              )
              && completionKept(incoming(), resource.data, true))
            || (resource.data.laboratoryId in access().memberLaboratoryIds
              && updatedNow(
                incoming(),
                touchFields().concat(participationChecklistEditableByLabMember()),
                participationChecklistRequired()
              )
              && completionKept(incoming(), resource.data, false)))
          && incoming().participationId == participationId
          && validChecklistItem(incoming(), resource.data);
      }

      // Reads: 3 (access, the participation, the person).
      match /teamMembers/{personId} {
        function participationTeamMembersFields() {
          return ['participationId', 'personId', 'role', 'replicationId', 'laboratoryId', 'scopeKeys'];
        }
        function participationTeamMembersRequired() {
          return ['participationId', 'personId', 'role', 'replicationId', 'laboratoryId', 'scopeKeys'];
        }
        function participationTeamMembersEditable() { return ['participationId', 'role']; }

        allow create: if isMember()
          && canForUnit('participationsManage', incoming().replicationId, incoming().laboratoryId)
          && createdNow(incoming(), participationTeamMembersFields(), participationTeamMembersRequired())
          && inheritsScope(incoming())
          && incoming().personId == personId
          && incoming().role in ['localLead', 'experimenter', 'analyst', 'dataManager', 'member']
          && personExists(personId);
        allow update: if isMember()
          && canForUnit('participationsManage', resource.data.replicationId, resource.data.laboratoryId)
          && updatedNow(
            incoming(),
            stampFields().concat(participationTeamMembersEditable()),
            participationTeamMembersRequired()
          )
          && incoming().participationId == participationId
          && incoming().role in ['localLead', 'experimenter', 'analyst', 'dataManager', 'member'];
      }

      // The acknowledgement of a protocol version by a person: created once, never changed.
      // It is the act of the person it names, so only that person records it: a person on the
      // team of the participation, for a version that is approved, at the request time. Nobody
      // acknowledges for someone else, and an acknowledgement of an earlier date belongs to an
      // import.
      // Reads: 5 (access, the person, the participation, the team entry, the protocol version).
      match /acknowledgements/{acknowledgementId} {
        function participationAcknowledgementsFields() {
          return [
            'participationId', 'protocolId', 'protocolVersionId', 'personId', 'acknowledgedAt', 'replicationId',
            'laboratoryId', 'scopeKeys'
          ];
        }
        function participationAcknowledgementsRequired() {
          return [
            'participationId', 'protocolId', 'protocolVersionId', 'personId', 'acknowledgedAt', 'replicationId',
            'laboratoryId', 'scopeKeys'
          ];
        }

        function onTheTeam(personId) {
          let entry = get(/databases/$(database)/documents/participations/$(participationId)/teamMembers/$(personId)).data;
          return entry.archivedAt == null;
        }

        function approvedVersionOf(d) {
          let version = get(/databases/$(database)/documents/replications/$(d.replicationId)/protocolVersions/$(d.protocolVersionId)).data;
          return version.protocolId == d.protocolId && version.status == 'approved' && version.archivedAt == null;
        }

        allow create: if isMember()
          && acknowledgementId == incoming().personId + '__' + incoming().protocolVersionId
          && person(incoming().personId).userId == request.auth.uid
          && appendedNow(incoming(), participationAcknowledgementsFields(), participationAcknowledgementsRequired())
          && inheritsScope(incoming())
          && incoming().acknowledgedAt == request.time
          && onTheTeam(incoming().personId)
          && approvedVersionOf(incoming());
      }

      // A deviation from the protocol. It names the account that reported it, which never
      // changes, and what was reported is the reporter's: only the reporter, programme
      // administrators and the core team change the description, the severity or the time,
      // resolve the deviation or archive it. The other side adds a corrective action and
      // moves an open deviation to underReview.
      // Reads: 2 (access, the participation).
      match /deviations/{deviationId} {
        function participationDeviationsFields() {
          return [
            'participationId', 'description', 'severity', 'occurredAt', 'reportedBy', 'correctiveAction', 'status',
            'replicationId', 'laboratoryId', 'scopeKeys'
          ];
        }
        function participationDeviationsRequired() {
          return [
            'participationId', 'description', 'severity', 'occurredAt', 'reportedBy', 'status', 'replicationId',
            'laboratoryId', 'scopeKeys'
          ];
        }
        function participationDeviationsEditable() {
          return ['participationId', 'description', 'severity', 'occurredAt', 'reportedBy', 'correctiveAction', 'status'];
        }

        function validDeviation(d) {
          return longText(d.description)
            && d.severity in ['minor', 'major', 'critical']
            && d.occurredAt is timestamp
            && longText(d.get('correctiveAction', 'x'))
            && d.status in ['open', 'underReview', 'resolved'];
        }

        function followsUp(d, stored) {
          return changed().hasOnly(touchFields().concat(['correctiveAction', 'status']))
            && (d.status == stored.status || (stored.status == 'open' && d.status == 'underReview'));
        }

        allow create: if isMember()
          && canForUnit('participationsManage', incoming().replicationId, incoming().laboratoryId)
          && autoId(deviationId)
          && createdNow(incoming(), participationDeviationsFields(), participationDeviationsRequired())
          && inheritsScope(incoming())
          && incoming().reportedBy == request.auth.uid
          && validDeviation(incoming());
        allow update: if isMember()
          && canForUnit('participationsManage', resource.data.replicationId, resource.data.laboratoryId)
          && (resource.data.reportedBy == request.auth.uid
            || canForProgramme('participationsManage')
            || followsUp(incoming(), resource.data))
          && updatedNow(
            incoming(),
            stampFields().concat(participationDeviationsEditable()),
            participationDeviationsRequired()
          )
          && incoming().participationId == participationId
          && incoming().reportedBy == resource.data.reportedBy
          && validDeviation(incoming());
      }
    }

    // What sits beneath a participation is read within its scope, beneath one participation or
    // across the participations of a unit the caller belongs to.
    // Reads: 1 (access).
    match /{path=**}/checklist/{itemKey} {
      allow read: if isMember() && (core() || withinUnit(resource.data)) && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/teamMembers/{personId} {
      allow read: if isMember() && (core() || withinUnit(resource.data)) && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/acknowledgements/{acknowledgementId} {
      allow read: if isMember() && (core() || withinUnit(resource.data)) && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/deviations/{deviationId} {
      allow read: if isMember() && (core() || withinUnit(resource.data)) && boundedRead();
    }

    // The template from which a function creates the checklist of a participation. Its items
    // are a list of maps, and a rule cannot iterate, so a client writes fifteen items at most:
    // the rule reads the key and the label at each of fifteen positions and checks the two
    // lists as a whole. Trusted code writes a longer template.
    // Reads: 1 (access).
    match /checklistTemplates/{templateKey} {
      function checklistTemplatesFields() { return ['key', 'items']; }
      function checklistTemplatesRequired() { return ['key', 'items']; }
      function checklistTemplatesEditable() { return ['items']; }

      // The list is filled up to fifteen positions with a blank item, so that every position can
      // be read whatever the length of the list. Each item holds a key and a label, which
      // reading them proves, and nothing else, which the sum of the sizes proves. The keys are
      // keys in the strict sense and differ from one another, and the labels are short texts.
      function validItems(l) {
        let blank = {'key': 'x', 'label': 'x'};
        let padded = l.concat([
          blank, blank, blank, blank, blank, blank, blank, blank, blank, blank, blank, blank, blank, blank, blank
        ]);
        let keys = [
          padded[0].key, padded[1].key, padded[2].key, padded[3].key, padded[4].key, padded[5].key,
          padded[6].key, padded[7].key, padded[8].key, padded[9].key, padded[10].key, padded[11].key,
          padded[12].key, padded[13].key, padded[14].key
        ][0:l.size()];
        let labels = [
          padded[0].label, padded[1].label, padded[2].label, padded[3].label, padded[4].label, padded[5].label,
          padded[6].label, padded[7].label, padded[8].label, padded[9].label, padded[10].label, padded[11].label,
          padded[12].label, padded[13].label, padded[14].label
        ][0:l.size()];
        return l.size() >= 1
          && l.size() <= 15
          && padded[0].size() + padded[1].size() + padded[2].size() + padded[3].size() + padded[4].size()
            + padded[5].size() + padded[6].size() + padded[7].size() + padded[8].size() + padded[9].size()
            + padded[10].size() + padded[11].size() + padded[12].size() + padded[13].size() + padded[14].size() == 30
          && strings(keys)
          && !('' in keys)
          && keys.join('\n').matches('^([A-Za-z0-9]([A-Za-z0-9-]|_[A-Za-z0-9-])*(\n|$))*$')
          && keys.join('\n').matches('^([^\n]{1,100}(\n|$))*$')
          && keys.toSet().size() == l.size()
          && shortTexts(labels, 15);
      }

      function validTemplate(d) {
        return d.items is list && validItems(d.items);
      }

      allow read: if isMember() && boundedRead();
      allow create: if isMember() && canForProgramme('lookupsManage')
        && createdNow(incoming(), checklistTemplatesFields(), checklistTemplatesRequired())
        && incoming().key == templateKey
        && key(templateKey)
        && validTemplate(incoming());
      allow update: if isMember() && canForProgramme('lookupsManage')
        && updatedNow(incoming(), stampFields().concat(checklistTemplatesEditable()), checklistTemplatesRequired())
        && validTemplate(incoming());
    }

    // The historical recruitment correspondence, for whoever holds `outreach.read`: the leads
    // of the replication and the programme. A row whose tab has not been resolved to a
    // replication is for the programme alone. Written by the importers.
    // Reads: 1 (access).
    match /outreachContacts/{contactId} {
      allow read: if isMember() && canForReplication('outreachRead', resource.data.replicationId) && boundedRead();
    }

    // ===== Recruitment (section 7) =====

    // Reads: 2 (access, the replication of a category that extends one).
    match /countCategories/{categoryKey} {
      function countCategoriesFields() { return ['key', 'label', 'definition', 'position', 'isCore', 'replicationId']; }
      function countCategoriesRequired() { return ['key', 'label', 'definition', 'position', 'isCore']; }
      function countCategoriesEditable() { return ['label', 'definition', 'position', 'isCore']; }

      function validCategory(d) {
        return shortText(d.label) && longText(d.definition) && d.position is int && d.position >= 0 && d.isCore is bool;
      }

      // The key of a category is a segment of a field path in a report, so it is a key in the
      // strict sense: no full stop and no space.
      allow read: if isMember() && boundedRead();
      allow create: if isMember() && canForProgramme('lookupsManage')
        && createdNow(incoming(), countCategoriesFields(), countCategoriesRequired())
        && incoming().key == categoryKey
        && key(categoryKey)
        && validCategory(incoming())
        && (!('replicationId' in incoming())
          || (docId(incoming().replicationId) && replicationExists(incoming().replicationId)));
      allow update: if isMember() && canForProgramme('lookupsManage')
        && updatedNow(incoming(), stampFields().concat(countCategoriesEditable()), countCategoriesRequired())
        && validCategory(incoming());
    }

    // ===== Scientific outputs and governance (section 11) =====

    // The scope fields of an output that names a replication are that replication's key, and
    // the replication exists. An output of the programme as a whole carries none.
    function outputOfReplication(d) {
      return d.scopeKeys == ['rep:' + d.replicationId] && replicationExists(d.replicationId);
    }

    // `status` and `statusHistoryId` change through a callable function. A manuscript starts
    // as planned. The identifier of the public website and the result of the citation check
    // are written by trusted code.
    // Reads: 2 (access, the replication).
    match /manuscripts/{manuscriptId} {
      function manuscriptsFields() {
        return [
          'replicationId', 'websitePublicationId', 'title', 'kind', 'status', 'statusHistoryId', 'journal', 'doi',
          'preprintDoi', 'osfUrl', 'authorsShort', 'submittedAt', 'acceptedAt', 'publishedAt', 'citationStatus',
          'citationMetadata', 'custom', 'scopeKeys'
        ];
      }
      function manuscriptsRequired() { return ['title', 'kind', 'status', 'statusHistoryId', 'custom', 'scopeKeys']; }
      function manuscriptsEditable() {
        return [
          'title', 'kind', 'journal', 'doi', 'preprintDoi', 'osfUrl', 'authorsShort', 'submittedAt', 'acceptedAt',
          'publishedAt', 'custom'
        ];
      }

      function validManuscript(d) {
        return d.title.matches('(?s)^.{1,1000}$')
          && d.kind in ['stage1Rr', 'stage2Rr', 'preprint', 'article', 'dataPaper', 'software', 'other']
          && shortText(d.get('journal', 'x'))
          && doi(d.get('doi', '10.1000/x'))
          && doi(d.get('preprintDoi', '10.1000/x'))
          && webAddress(d.get('osfUrl', 'https://example.org'))
          && shortText(d.get('authorsShort', 'x'))
          && d.get('submittedAt', request.time) is timestamp
          && d.get('acceptedAt', request.time) is timestamp
          && d.get('publishedAt', request.time) is timestamp
          && customValues(d.custom);
      }

      allow read: if isMember() && boundedRead();
      allow create: if isMember()
        && canManageOutputsOf(incoming().get('replicationId', null))
        && autoId(manuscriptId)
        && ('replicationId' in incoming() ? outputOfReplication(incoming()) : incoming().scopeKeys == [])
        && createdNow(incoming(), manuscriptsFields(), manuscriptsRequired())
        && incoming().status == 'planned'
        && incoming().statusHistoryId == null
        && !incoming().keys().hasAny(['websitePublicationId', 'citationStatus', 'citationMetadata'])
        && validManuscript(incoming());
      allow update: if isMember()
        && canManageOutputsOf(resource.data.get('replicationId', null))
        && updatedNow(incoming(), stampFields().concat(manuscriptsEditable()), manuscriptsRequired())
        && validManuscript(incoming());

      // A review round, a decision, a revision or a submission. Its scope fields are those of
      // the manuscript.
      // Reads: 2 (access, the manuscript).
      match /events/{eventId} {
        function manuscriptEventsFields() {
          return [
            'manuscriptId', 'kind', 'round', 'occurredAt', 'dueAt', 'outcome', 'summary', 'documentLinkIds',
            'replicationId', 'laboratoryId', 'scopeKeys'
          ];
        }
        function manuscriptEventsRequired() {
          return ['manuscriptId', 'kind', 'occurredAt', 'documentLinkIds', 'replicationId', 'laboratoryId', 'scopeKeys'];
        }
        function manuscriptEventsEditable() {
          return ['manuscriptId', 'kind', 'round', 'occurredAt', 'dueAt', 'outcome', 'summary', 'documentLinkIds'];
        }

        function validEvent(d) {
          return d.manuscriptId == manuscriptId
            && d.kind in ['submission', 'reviewRound', 'decision', 'revision', 'acceptance', 'publication', 'other']
            && count(d.get('round', 0), 100)
            && d.occurredAt is timestamp
            && d.get('dueAt', request.time) is timestamp
            && d.get('outcome', 'accept') in ['accept', 'inPrincipleAcceptance', 'minorRevision', 'majorRevision', 'reject']
            && longText(d.get('summary', 'x'))
            && docIds(d.documentLinkIds);
        }

        allow create: if isMember()
          && canManageOutputsOf(manuscript(manuscriptId).get('replicationId', null))
          && autoId(eventId)
          && createdNow(incoming(), manuscriptEventsFields(), manuscriptEventsRequired())
          && incoming().replicationId == manuscript(manuscriptId).get('replicationId', null)
          && incoming().laboratoryId == null
          && incoming().scopeKeys == manuscript(manuscriptId).scopeKeys
          && validEvent(incoming());
        allow update: if isMember()
          && canManageOutputsOf(resource.data.replicationId)
          && updatedNow(incoming(), stampFields().concat(manuscriptEventsEditable()), manuscriptEventsRequired())
          && validEvent(incoming());
      }
    }

    // Reads: 1 (access).
    match /{path=**}/events/{eventId} {
      allow read: if isMember() && boundedRead();
    }

    // Reads: 2 (access, the replication).
    match /contributorTables/{tableId} {
      function contributorTablesFields() {
        return ['replicationId', 'sourceKey', 'isOnlySignupTable', 'isPublished', 'publicationUrl', 'pdfUrl', 'scopeKeys'];
      }
      function contributorTablesRequired() { return ['replicationId', 'sourceKey', 'scopeKeys']; }
      function contributorTablesEditable() {
        return ['sourceKey', 'isOnlySignupTable', 'isPublished', 'publicationUrl', 'pdfUrl'];
      }

      function validTable(d) {
        return key(d.sourceKey)
          && d.get('isOnlySignupTable', false) is bool
          && d.get('isPublished', false) is bool
          && webAddress(d.get('publicationUrl', 'https://example.org'))
          && webAddress(d.get('pdfUrl', 'https://example.org'));
      }

      allow read: if isMember()
        && (core() || holdsScopeOf(resource.data) || onTeam(resource.data.replicationId))
        && boundedRead();
      allow create: if isMember()
        && canManageOutputsOf(incoming().replicationId)
        && autoId(tableId)
        && (incoming().replicationId == null ? incoming().scopeKeys == [] : outputOfReplication(incoming()))
        && createdNow(incoming(), contributorTablesFields(), contributorTablesRequired())
        && validTable(incoming());
      allow update: if isMember()
        && canManageOutputsOf(resource.data.replicationId)
        && updatedNow(incoming(), stampFields().concat(contributorTablesEditable()), contributorTablesRequired())
        && validTable(incoming());
    }

    // One row of a contributor table, from which the list of authors of a paper is drawn. It
    // grants no role and no access. Every member reads the rows, so a row stays within its
    // replication: its table and its manuscript are those of the replication it belongs to.
    // Reads: 5 (access, the replication, the contributor table, the manuscript, the person).
    match /contributors/{contributorId} {
      function contributorsFields() {
        return [
          'firstNameSource', 'middleNameSource', 'surnameSource', 'orderInPublication', 'affiliationSource',
          'affiliationSlotsSource', 'orcid', 'creditRoles', 'agreementSource', 'reviewStatus', 'replicationId',
          'manuscriptId', 'contributorTableId', 'personId', 'scopeKeys'
        ];
      }
      function contributorsRequired() {
        return ['creditRoles', 'reviewStatus', 'replicationId', 'manuscriptId', 'contributorTableId', 'personId', 'scopeKeys'];
      }
      function contributorsEditable() {
        return [
          'firstNameSource', 'middleNameSource', 'surnameSource', 'orderInPublication', 'affiliationSource',
          'affiliationSlotsSource', 'orcid', 'creditRoles', 'agreementSource', 'reviewStatus', 'manuscriptId',
          'contributorTableId', 'personId'
        ];
      }
      function contributorsVerbatim() {
        return [
          'firstNameSource', 'middleNameSource', 'surnameSource', 'affiliationSource', 'affiliationSlotsSource',
          'agreementSource'
        ];
      }

      // The 14 CRediT role keys of portal/shared/src/schemas/outputs.ts.
      function creditRoleKeys() {
        return [
          'conceptualization', 'dataCuration', 'formalAnalysis', 'fundingAcquisition', 'investigation',
          'methodology', 'projectAdministration', 'resources', 'software', 'supervision', 'validation',
          'visualization', 'writingOriginalDraft', 'writingReviewEditing'
        ];
      }

      // The cells of the affiliation columns, by slot from 1 to 9.
      function affiliationSlots(m) {
        return m.keys().hasOnly(['1', '2', '3', '4', '5', '6', '7', '8', '9']) && verbatims(m.values());
      }

      // The cells of the role columns: each a text, a number or a boolean, and 10,000
      // characters between them.
      function creditRoles(m) {
        return m.keys().hasOnly(creditRoleKeys())
          && !(null in m.values())
          && m.values().join('').size() <= 10000;
      }

      function validContributor(d) {
        return verbatim(d.get('firstNameSource', ''))
          && verbatim(d.get('middleNameSource', ''))
          && verbatim(d.get('surnameSource', ''))
          && count(d.get('orderInPublication', 0), 100000)
          && verbatim(d.get('affiliationSource', ''))
          && affiliationSlots(d.get('affiliationSlotsSource', {}))
          && verbatim(d.get('orcid', ''))
          && creditRoles(d.creditRoles)
          && verbatim(d.get('agreementSource', ''))
          && d.reviewStatus in ['confirmed', 'needsReview'];
      }

      // A reference that a write introduces stays within the replication of the row: the
      // table and the manuscript belong to it, and the person exists.
      function referencesKept(d, stored) {
        return (d.contributorTableId == stored.get('contributorTableId', null)
            || (docId(d.contributorTableId)
              && get(/databases/$(database)/documents/contributorTables/$(d.contributorTableId)).data.replicationId == d.replicationId))
          && (d.manuscriptId == null
            || d.manuscriptId == stored.get('manuscriptId', null)
            || (docId(d.manuscriptId) && manuscript(d.manuscriptId).get('replicationId', null) == d.replicationId))
          && (d.personId == null
            || d.personId == stored.get('personId', null)
            || (docId(d.personId) && personExists(d.personId)));
      }

      allow read: if isMember() && boundedRead();
      allow create: if isMember()
        && canManageOutputsOf(incoming().replicationId)
        && autoId(contributorId)
        && (incoming().replicationId == null ? incoming().scopeKeys == [] : outputOfReplication(incoming()))
        && createdNow(incoming(), contributorsFields(), contributorsRequired())
        && validContributor(incoming())
        && referencesKept(incoming(), {});
      allow update: if isMember()
        && canManageOutputsOf(resource.data.replicationId)
        && updatedNow(incoming(), stampFields().concat(contributorsEditable()), contributorsRequired())
        && sourceValuesKept(contributorsVerbatim())
        && validContributor(incoming())
        && referencesKept(incoming(), resource.data);

      // The email address and the funding statement of a contributor.
      // Reads: 2 (access, the contributor).
      match /private/contact {
        function contributorContactFields() { return ['email', 'fundingStatement']; }
        function contributorContactRequired() { return []; }
        function contributorContactEditable() { return ['email', 'fundingStatement']; }

        function validContact(d) {
          return verbatim(d.get('email', '')) && verbatim(d.get('fundingStatement', ''));
        }

        allow get: if isMember()
          && (core()
            || holdsScopeOf(contributor(contributorId))
            || onTeam(contributor(contributorId).replicationId));
        allow create: if isMember()
          && canManageOutputsOf(contributor(contributorId).replicationId)
          && createdNow(incoming(), contributorContactFields(), contributorContactRequired())
          && validContact(incoming());
        allow update: if isMember()
          && canManageOutputsOf(contributor(contributorId).replicationId)
          && updatedNow(incoming(), stampFields().concat(contributorContactEditable()), contributorContactRequired())
          && validContact(incoming());
      }
    }

    // An external document attached to a record. It carries the audience of its target as
    // scope fields: the keys of the target, with `members` beside them unless the link is
    // marked restricted. The rules check the copy against the target when a client creates a
    // link, for the targets below. A link to any other kind of record is written by trusted
    // code, which also rewrites the copy when the audience of a target changes. Whether the
    // address answers, and what it says of its owner, is the result of a check that trusted
    // code makes, and no client records one.
    // Reads: 2 (access, the target).
    match /documentLinks/{linkId} {
      function documentLinksFields() {
        return [
          'entityType', 'entityId', 'kind', 'url', 'externalId', 'title', 'accessStatus', 'httpStatus',
          'lastCheckedAt', 'ownerName', 'modifiedAt', 'restricted', 'replicationId', 'laboratoryId', 'scopeKeys'
        ];
      }
      function documentLinksRequired() {
        return [
          'entityType', 'entityId', 'kind', 'url', 'accessStatus', 'lastCheckedAt', 'restricted', 'replicationId',
          'laboratoryId', 'scopeKeys'
        ];
      }
      function documentLinksEditable() {
        return ['entityType', 'entityId', 'kind', 'url', 'externalId', 'title', 'restricted'];
      }

      // Where the records of a replication live that a link can be attached to.
      function replicationCollections() {
        return {'hypothesis': 'hypotheses', 'protocol': 'protocols', 'protocolVersion': 'protocolVersions'};
      }

      // The target exists, the scope fields name its replication and its laboratory, and the
      // caller manages one of them. The result is the scope keys of the target.
      function targetIsReplication(d) {
        return d.entityType == 'replication'
          && d.entityId == d.replicationId
          && d.laboratoryId == null
          && (core() || leads(d.replicationId))
          && replicationExists(d.replicationId);
      }

      function targetIsLaboratory(d) {
        return d.entityType == 'laboratory'
          && d.entityId == d.laboratoryId
          && d.replicationId == null
          && (core() || coordinates(d.laboratoryId))
          && laboratoryExists(d.laboratoryId);
      }

      function targetIsParticipation(d) {
        return d.entityType == 'participation'
          && participation(d.entityId).replicationId == d.replicationId
          && participation(d.entityId).laboratoryId == d.laboratoryId
          && (core() || leads(d.replicationId) || coordinates(d.laboratoryId));
      }

      // A hypothesis, a protocol or a protocol version: the identifier of the entity is the
      // study identifier joined to the identifier of the document beneath it.
      function targetIsBeneathReplication(d) {
        return d.entityType in replicationCollections()
          && d.laboratoryId == null
          && d.entityId.size() > d.replicationId.size() + 2
          && d.entityId[0:d.replicationId.size() + 2] == d.replicationId + '__'
          && (core() || leads(d.replicationId))
          && exists(/databases/$(database)/documents/replications/$(d.replicationId)/$(replicationCollections()[d.entityType])/$(d.entityId[d.replicationId.size() + 2:d.entityId.size()]));
      }

      function targetIsManuscript(d) {
        return d.entityType == 'manuscript'
          && d.laboratoryId == null
          && d.replicationId == manuscript(d.entityId).get('replicationId', null)
          && (core() || leads(d.replicationId));
      }

      function unitKeys(d) {
        return d.replicationId == null
          ? (d.laboratoryId == null ? [] : ['lab:' + d.laboratoryId])
          : (d.laboratoryId == null
            ? ['rep:' + d.replicationId]
            : ['rep:' + d.replicationId, 'lab:' + d.laboratoryId]);
      }

      function validLink(d) {
        return d.kind in ['googleDoc', 'googleSheet', 'driveFolder', 'osf', 'github', 'pdf', 'form', 'url']
          && webAddress(d.url)
          && shortText(d.get('externalId', 'x'))
          && shortText(d.get('title', 'x'))
          && d.restricted is bool;
      }

      allow read: if isMember() && (core() || holdsScopeOf(resource.data)) && boundedRead();
      allow create: if isMember()
        && autoId(linkId)
        && docId(incoming().entityId)
        && (targetIsReplication(incoming())
          || targetIsLaboratory(incoming())
          || targetIsParticipation(incoming())
          || targetIsBeneathReplication(incoming())
          || targetIsManuscript(incoming()))
        && incoming().scopeKeys == (incoming().restricted ? unitKeys(incoming()) : unitKeys(incoming()).concat(['members']))
        && createdNow(incoming(), documentLinksFields(), documentLinksRequired())
        && incoming().accessStatus == 'unknown'
        && incoming().lastCheckedAt == null
        && !incoming().keys().hasAny(['httpStatus', 'ownerName', 'modifiedAt'])
        && validLink(incoming());
      // The target and the audience of a link never change through a client.
      allow update: if isMember()
        && (core() || leads(resource.data.replicationId) || coordinates(resource.data.laboratoryId))
        && updatedNow(incoming(), stampFields().concat(documentLinksEditable()), documentLinksRequired())
        && incoming().entityType == resource.data.entityType
        && incoming().entityId == resource.data.entityId
        && incoming().restricted == resource.data.restricted
        && validLink(incoming());
    }

    // ===== Provenance, migration and integrations (section 12) =====
    //
    // Importers write all of this with the Admin SDK. Whoever runs imports reads the source
    // registry, the batches and the raw rows. The address of a source document and every
    // special-category cell sit in documents that have no rule, so no client reads them.
    // No block of this section reads more than the access document of the caller.

    // Reads: 1 (access).
    match /sources/{sourceKey} {
      allow read: if isMember() && canForProgramme('importsRun') && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/tabs/{tabKey} {
      allow read: if isMember() && canForProgramme('importsRun') && boundedRead();
    }

    // Reads: 1 (access).
    match /importBatches/{batchId} {
      allow read: if isMember() && canForProgramme('importsRun') && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/changes/{changeId} {
      allow read: if isMember() && canForProgramme('importsRun') && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/seenRecords/{chunkId} {
      allow read: if isMember() && canForProgramme('importsRun') && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/log/{entryId} {
      allow read: if isMember() && canForProgramme('importsRun') && boundedRead();
    }

    // Reads: 1 (access).
    match /sourceRecords/{recordId} {
      allow read: if isMember() && canForProgramme('importsRun') && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/rawChunks/{chunkId} {
      allow read: if isMember() && canForProgramme('importsRun') && boundedRead();
    }

    // Reads: 1 (access).
    match /reconciliationItems/{fingerprint} {
      allow read: if isMember() && canForProgramme('reconciliationResolve') && boundedRead();
    }

    // Reads: 1 (access).
    match /integrationMappings/{mappingId} {
      allow read: if isMember() && canForProgramme('integrationsManage') && boundedRead();
    }

    // ===== Events, audit, automation, notifications and search (section 13) =====

    // The audit trail and the outbound mail are written by trusted code and have no rule: no
    // client reads or writes them. An administrator consults the trail through a function.

    // Reads: 1 (access).
    match /integrityReports/{runId} {
      allow read: if isMember() && canForProgramme('auditRead') && boundedRead();
    }

    // Reads: 1 (access).
    match /{path=**}/findings/{findingId} {
      allow read: if isMember() && canForProgramme('auditRead') && boundedRead();
    }

    // Reads: 1 (access).
    match /system/settings {
      allow get: if isMember();
    }

    // Everything else is denied: the collections that only functions read and write, the
    // collections whose features are not built yet, and any path that does not exist.
    // Reads: 0.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
