# Firebase web configuration for a staging or production build.
#
# Copy this file to .env.staging.local or .env.production.local and fill it in. Those files are
# ignored by git. The values are the web application's public configuration from the Firebase
# console (Project settings, Your apps). They are not secrets, but they do name a real project,
# so they are kept out of this public repository.
#
# The emulator mode needs none of these. It is the default for `npm run dev`, `npm run build`
# and every test.

# Required in staging and production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Optional.
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set to true to build the "Continue with Google" button in. Works in every mode.
VITE_ENABLE_GOOGLE_SIGN_IN=false

# How a page shows who else has it open: cursor (names and carets, the default), presence
# (names only) or off.
VITE_PRESENCE=cursor

# The path the built files are published under, with a slash at both ends. It is used for the
# link on the page that GitHub Pages shows for an unknown address. "/" suits a domain of its
# own. On a default Pages address use "/<repository>/".
PORTAL_PUBLIC_PATH=/
