{% set initiatives = [
  {"name": "EEG101", "description": "European COST Action connecting researchers, clinicians, engineers, and stakeholders around open, rigorous, and globally inclusive EEG science.", "url": "https://www.eeg101.eu", "image": "partners/eeg101-logo.png"},
  {"name": "CuttingEEG", "description": "Community association advancing contemporary EEG methods through the CuttingGardens distributed conference model.", "url": "https://cuttingeeg.org", "image": "partners/cuttingeeg-logo.png"},
  {"name": "INDOS", "description": "European COST Action focused on improving how human neuroimaging data are shared and reused.", "url": "https://www.indos-costaction.eu", "image": "partners/indos_logo.png"},
  {"name": "Global Brain Consortium", "description": "International network promoting diversity and inclusion in neuroscience research across the globe.", "url": "https://globalbrainconsortium.org", "image": "partners/gbc-logo.png"},
  {"name": "Global Brain Health Institute", "description": "International organisation advancing equitable approaches to brain health worldwide.", "url": "https://www.gbhi.org", "image": "partners/gbhi-logo.svg"},
  {"name": "African Brain Data Network", "description": "Network supporting open, FAIR neuroscience data and globally representative brain science from African research sites.", "url": "https://africanbraindatanetwork.com", "image": "partners/abdn-logo.jpg"}
] %}
{% set tools = [
  {"name": "FieldTrip", "description": "Open-source MATLAB toolbox for advanced analysis of MEG, EEG, and invasive electrophysiological data.", "url": "https://www.fieldtriptoolbox.org", "image": "partners/fieldtrip-logo.png"},
  {"name": "ARTEM-IS", "description": "Standardised reporting tools for EEG research, providing web-based guidance for experimental documentation.", "url": "https://artemis.incf.org/about", "image": "partners/artemis-logo.png"},
  {"name": "EEGNet", "description": "Platform combining standardised annotated EEG data and analytics for global health applications.", "url": "https://eegnet.org", "image": "partners/eegnet-logo.png"}
] %}

<section class="partners-section" aria-labelledby="partner-initiatives-heading">
  <p class="partners-section__intro">#EEGManyLabs works alongside organisations and initiatives that share a commitment to rigorous, open, and inclusive EEG research.</p>
  <h2 id="partner-initiatives-heading">Partner initiatives</h2>
  <div class="partner-grid">
    {% for partner in initiatives %}
      <a class="partner-card" href="{{ partner.url }}" target="_blank" rel="noopener">
        <div class="partner-card__logo"><img src="/assets/images/{{ partner.image }}" alt="{{ partner.name }} logo" loading="lazy"></div>
        <div class="partner-card__content"><h3>{{ partner.name }}</h3><p>{{ partner.description }}</p><span>Visit website</span></div>
      </a>
    {% endfor %}
  </div>
</section>
<section class="partners-section partners-section--tools" aria-labelledby="partner-tools-heading">
  <h2 id="partner-tools-heading">Partner tools and platforms</h2>
  <div class="partner-grid">
    {% for partner in tools %}
      <a class="partner-card" href="{{ partner.url }}" target="_blank" rel="noopener">
        <div class="partner-card__logo"><img src="/assets/images/{{ partner.image }}" alt="{{ partner.name }} logo" loading="lazy"></div>
        <div class="partner-card__content"><h3>{{ partner.name }}</h3><p>{{ partner.description }}</p><span>Visit website</span></div>
      </a>
    {% endfor %}
  </div>
</section>
