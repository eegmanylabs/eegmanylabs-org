{% import 'macros/action_button.jinja2' as ActionButton %}

<sl-card id="{{ leaf.name }}" class="study-card {{ leaf.front['StageID'] }} {{ leaf.front['Theme']|lower }}">
  <div slot="header" class="study-card__header">
    <div>
      <p class="card-kicker">Replication study</p>
      <h2>{{ leaf.front['StudyId'] }}</h2>
    </div>
    <sl-tooltip content="{{ leaf.front['Title'] }} - {{ leaf.front['AuthorShort'] }}">
      <sl-icon-button name="info-circle" href="{{ leaf.front['DoiUrl'] }}" target="_blank" label="View source publication"></sl-icon-button>
    </sl-tooltip>
  </div>

  <img slot="image" src="/assets/images/{{ leaf.front['Image'] }}" alt="Visual summary for {{ leaf.front['StudyId'] }}" loading="lazy" />

  <div class="card-body">
    {{ leaf.content_html|safe }}
    <div class="metadata-row">
      <span class="metadata-label">Stage</span>
      <span class="tag stage {{ leaf.front['StageID'] }}">{{ leaf.front['LongStage'] }}</span>
    </div>
    <div class="metadata-row">
      <span class="metadata-label">Theme</span>
      <span class="tag theme {{ leaf.front['Theme'] }}">{{ leaf.front['Theme'] }}</span>
    </div>

    {% set PublicationUrl = leaf.front['PublicationId'] %}
    {% if PublicationUrl != "None" %}
      {% set PublicationUrl = "/publications/#" ~ PublicationUrl %}
      {% set PublicationText = "View replication materials" %}
    {% else %}
      {% set PublicationText = "Materials forthcoming" %}
    {% endif %}
    <div class="card-buttons">
      {{ ActionButton.render(PublicationUrl, PublicationText, "", "fas-book-open", false) }}
      {% if leaf.front['SignupUrl'] != "done" %}
        {{ ActionButton.render(leaf.front['SignupUrl'], "Join this replication", "Join study", "fas-user-plus") }}
      {% endif %}
    </div>
  </div>
</sl-card>
