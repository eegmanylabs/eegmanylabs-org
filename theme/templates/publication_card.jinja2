{% from 'macros/utils.jinja2' import add_button %}

<sl-card id="{{ leaf.name }}" class="publication-card">
  <div class="publication-card__content">
    <h2>{{ leaf.front['Title'] }}</h2>
    <p class="publication-card__authors">{{ leaf.front['AuthorShort'] }}</p>
    <p class="publication-card__journal">{{ leaf.front['Journal'] }}</p>

    <div class="tag-list publication-card__status" aria-label="Publication status">
      {% for tag, text in leaf.front.Tags.items() %}
        {{ add_button(tag, text|title) }}
      {% endfor %}
    </div>

    <p class="publication-card__doi"><a href="{{ leaf.front['DoiUrl'] }}" target="_blank" rel="noopener">DOI: {{ leaf.front['DOI'] }}</a></p>

    <div class="tag-list publication-card__resources" aria-label="Publication resources">
      {{ add_button("paper", "PDF", leaf.front['Pdf']) }}
      {% if leaf.front['OsfUrl'] != "None" %}
        {{ add_button("osf", "OSF materials", leaf.front['OsfUrl']) }}
      {% endif %}
      {% if leaf.front['DataUrl'] != "None" %}
        {{ add_button("data", "Data", leaf.front['DataUrl']) }}
      {% endif %}
    </div>
  </div>
</sl-card>
