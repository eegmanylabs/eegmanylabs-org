<section class="publication-resource-strip" aria-label="Project resources">
  <a class="publication-resource-tile publication-resource-tile--scholar" href="{{ index.front.scholar_link }}" target="_blank" rel="noopener"><sl-icon name="fab-google-scholar" aria-hidden="true"></sl-icon><span><strong>Google Scholar</strong><small>Project publications</small></span></a>
  <a class="publication-resource-tile publication-resource-tile--osf" href="{{ index.front.osf_link }}" target="_blank" rel="noopener"><img src="/assets/images/osf_logo.png" alt=""><span><strong>OSF</strong><small>Project materials</small></span></a>
  <a class="publication-resource-tile publication-resource-tile--gin" href="{{ index.front.gnode_link }}" target="_blank" rel="noopener"><img src="/assets/images/gin_logo.png" alt=""><span><strong>GIN</strong><small>Project datasets</small></span></a>
</section>

<h2>About #EEGManyLabs</h2>
{% for leaf in index.leaves if leaf.front['PublicationId'] == "Pavlov2021" %}{% include 'publication_card.jinja2' %}{% endfor %}
<h2>Related projects</h2>
{% for leaf in index.leaves if leaf.front['ReplicationId'] == "None" and leaf.front['PublicationId'] != "Pavlov2021" %}{% include 'publication_card.jinja2' %}{% endfor %}
<h2>Replications</h2>
{% for repID, group in index.leaves|groupby("front.ReplicationId") %}{% if repID != "None" %}{% for leaf in group %}{% include 'publication_card.jinja2' %}{% endfor %}{% endif %}{% endfor %}
