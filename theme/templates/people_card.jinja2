{% import 'macros/icon_button.jinja2' as IconButton %}
{% from 'macros/utils.jinja2' import add_button %}
{% set role_labels = {"directors": "Director", "coordinator": "Coordinator", "founder": "Founder", "advisor": "Advisor", "study_lead": "Study lead", "co-investigator": "Co-investigator", "spin-off": "Spin-off", "contributor": "Contributor"} %}

<sl-card id="{{ leaf.name }}" class="person-card {{ leaf.front['Tags']|join(" ") }}" data-filter-card data-role="{{ leaf.front['Tags']|join(' ') }}">
  {% if leaf.front['Image'] != "None" %}
    {% set imageURL = leaf.front['Image'] %}
  {% else %}
    {% set imageURL = "missing_person.avif" %}
  {% endif %}

  <img slot="image" src="/assets/images/{{ imageURL }}" alt="Portrait of {{ leaf.front['FullName'] }}" loading="lazy" />
  <div class="person-card__content">
    <h2>{{ leaf.front['FullName'] }}</h2>
    <p class="person-card__affiliation">{{ leaf.front['Affiliation'] }}{% if leaf.front['Country'] != "Unaffiliated" %}<span aria-hidden="true"> · </span><span>{{ leaf.front['Country'] }}</span>{% endif %}</p>
    {{ leaf.content_html|safe }}
    <div class="tag-list" aria-label="Roles">
      {% for tag in leaf.front['Tags'] %}
        {{ add_button(tag, role_labels.get(tag, tag|replace('_', ' ')|replace('-', ' ')|capitalize)) }}
      {% endfor %}
    </div>
  </div>

  <div slot="footer" class="person-card__links">
    {{ IconButton.render(leaf.front['ScholarUrl'], "Google Scholar profile", "fab-google-scholar") }}
    {{ IconButton.render(leaf.front['UniUrl'], "University profile page", "fas-building-columns") }}
    {{ IconButton.render(leaf.front['LabUrl'], "Lab website", "fas-flask") }}
    {% if leaf.front['StudyId'] != "None" %}
      {% set replicationUrl = "/replications/#" ~ leaf.front['StudyId'] %}
      {{ IconButton.render(replicationUrl, "Replication page", "fas-clipboard", external = false) }}
    {% endif %}
  </div>
</sl-card>
