{% extends 'master.jinja2' %}

{% block main %}
<article id="{{ index.name }}" class="section-page section-page--{{ index.name|replace('_', '-') }}">
  {% if index.name == "about" %}
    <section class="longform longform--about">
      {% include 'about_page.jinja2' %}
    </section>
  {% else %}
    {% set replications_count = index.leaves | length | string %}
    <section class="section-hero">
      <div class="section-hero__title">
        {{ index.content_html|replace("replications_count", replications_count)|safe }}
      </div>
    </section>

    {% if index.name == "replications" or index.name == "people" %}
      <div class="select-container filter-controls" aria-label="Filter content">
        {% if index.name == "replications" %}
          <sl-select id="stage" placeholder="Replication Stage" value="" clearable></sl-select>
          <sl-select id="theme" placeholder="Themes" value="" clearable></sl-select>
        {% elif index.name == "people" %}
          <sl-select id="tag" placeholder="Tags" value="" multiple clearable></sl-select>
        {% endif %}
      </div>
    {% endif %}

    <section class="content-collection">
      <div class="card-grid">
        {% if index.name == "publications" %}
          {% include 'publication_page.jinja2' %}
        {% elif index.name == "replications" %}
          {% for leaf in index.leaves %}
            {% include 'replication_card.jinja2' %}
          {% endfor %}
        {% elif index.name == "people" %}
          {% for leaf in index.leaves|sort(attribute='front.SequenceNumber') %}
            {% include 'people_card.jinja2' %}
          {% endfor %}
        {% else %}
          {% for leaf in index.leaves %}
            {% include 'spinoff_card.jinja2' %}
          {% endfor %}
        {% endif %}
      </div>
    </section>
  {% endif %}
</article>
{% endblock %}
