{% extends 'master.jinja2' %}

{% block main %}
<article id="{{ index.name }}" class="section-page section-page--{{ index.name|replace('_', '-') }}">
  {% if index.name == "about" %}
    <section class="longform longform--about">
      {% include 'about_page.jinja2' %}
    </section>
  {% elif index.name in ["BIDS_tutorial", "asymmetry", "automation", "eeg100", "electrotime", "prediction-markets", "resting-state"] %}
    {% include 'related_project_page.jinja2' %}
  {% else %}
    {% set replications_count = index.leaves | length | string %}
    <section class="section-hero">
      <div class="section-hero__title">
        {{ index.content_html|replace("replications_count", replications_count)|safe }}
      </div>
    </section>

    {% if index.name == "replications" %}
      <div class="chip-filters chip-filters--replications" data-chip-filters data-filter-target="#replications [data-filter-card]" aria-label="Filter replications">
        <div class="chip-filters__group"><span class="chip-filters__label">Stage</span><div class="chip-filters__list" role="group" aria-label="Replication stage">
          <button type="button" class="filter-chip is-active" data-filter-key="stage" data-filter-value="">All stages</button>
          <button type="button" class="filter-chip" data-filter-key="stage" data-filter-value="4_stage1_prep">Stage 1 preparation</button>
          <button type="button" class="filter-chip" data-filter-key="stage" data-filter-value="5_stage1_review">Stage 1 review</button>
          <button type="button" class="filter-chip" data-filter-key="stage" data-filter-value="6_data_collection">Data collection</button>
          <button type="button" class="filter-chip" data-filter-key="stage" data-filter-value="7_stage2_prep">Stage 2 preparation</button>
          <button type="button" class="filter-chip" data-filter-key="stage" data-filter-value="9_finished">Completed</button>
        </div></div>
        <div class="chip-filters__group"><span class="chip-filters__label">Theme</span><div class="chip-filters__list" role="group" aria-label="Replication theme">
          <button type="button" class="filter-chip is-active" data-filter-key="theme" data-filter-value="">All themes</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="attention">Attention</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="conflict">Conflict</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="consciousness">Consciousness</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="emotion">Emotion</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="error">Error</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="feedback">Feedback</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="learning">Learning</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="memory">Memory</button>
          <button type="button" class="filter-chip" data-filter-key="theme" data-filter-value="personality">Personality</button>
        </div></div>
      </div>
    {% elif index.name == "people" %}
      <div class="chip-filters" data-chip-filters data-filter-target="#people [data-filter-card]" aria-label="Filter Core Team roles">
        <span class="chip-filters__label">Filter roles</span>
        <div class="chip-filters__list" role="group" aria-label="Core Team roles">
          <button type="button" class="filter-chip is-active" data-filter-key="role" data-filter-value="">All</button>
          <button type="button" class="filter-chip" data-filter-key="role" data-filter-value="directors">Directors</button>
          <button type="button" class="filter-chip" data-filter-key="role" data-filter-value="coordinator">Coordinators</button>
          <button type="button" class="filter-chip" data-filter-key="role" data-filter-value="founder">Founder</button>
          <button type="button" class="filter-chip" data-filter-key="role" data-filter-value="advisor">Advisors</button>
          <button type="button" class="filter-chip" data-filter-key="role" data-filter-value="study_lead">Study leads</button>
          <button type="button" class="filter-chip" data-filter-key="role" data-filter-value="co-investigator">Co-investigators</button>
          <button type="button" class="filter-chip" data-filter-key="role" data-filter-value="spin-off">Spin-offs</button>
          <button type="button" class="filter-chip" data-filter-key="role" data-filter-value="contributor">Contributors</button>
        </div>
      </div>
    {% elif index.name == "publications" %}
      <div class="chip-filters" data-chip-filters data-filter-target="#publications [data-filter-card]" aria-label="Filter publications by status">
        <span class="chip-filters__label">Filter publications</span>
        <div class="chip-filters__list" role="group" aria-label="Publication status">
          <button type="button" class="filter-chip is-active" data-filter-key="status" data-filter-value="">All</button>
          <button type="button" class="filter-chip" data-filter-key="status" data-filter-value="published">Published</button>
          <button type="button" class="filter-chip" data-filter-key="status" data-filter-value="stage1">Stage 1</button>
          <button type="button" class="filter-chip" data-filter-key="status" data-filter-value="preprint">Preprints</button>
        </div>
      </div>
    {% endif %}

    {% if index.name == "contact" %}
      {% include 'contact_page.jinja2' %}
    {% elif index.name == "privacy" %}
      {% include 'privacy_page.jinja2' %}
    {% elif index.name == "site_map" %}
      {% include 'site_map_page.jinja2' %}
    {% elif index.name == "partners" %}
      {% include 'partners_page.jinja2' %}
    {% else %}
      <section class="content-collection">
        <div class="card-grid">
          {% if index.name == "publications" %}
            {% include 'publication_page.jinja2' %}
          {% elif index.name == "replications" %}
            {% for leaf in index.leaves %}
              {% include 'replication_card.jinja2' %}
            {% endfor %}
          {% elif index.name == "people" %}
            {% for leaf in index.leaves|sort(attribute='front.SequenceNumber') %}
              {% include 'people_card.jinja2' %}
            {% endfor %}
          {% elif index.name == "members" %}
            {% set member_characters = ["member-character-01.webp", "member-character-02.webp", "member-character-03.webp", "member-character-04.webp"] %}
            {% for leaf in index.leaves|sort(attribute='front.SequenceNumber') %}
              {% set member_character = member_characters[loop.index0 % (member_characters|length)] %}
              {% include 'member_card.jinja2' %}
            {% else %}
              <div class="directory-empty-state directory-empty-state--members">
                <div class="member-character-preview" aria-hidden="true">
                  {% for character in member_characters %}<img src="/assets/images/member-characters/{{ character }}" alt="">{% endfor %}
                </div>
                <p>The growing Scientists directory will appear here as further collaborators are added.</p>
              </div>
            {% endfor %}
          {% else %}
            {% for leaf in index.leaves %}
              {% include 'spinoff_card.jinja2' %}
            {% endfor %}
          {% endif %}
        </div>
      </section>
    {% endif %}
  {% endif %}
</article>
{% endblock %}
