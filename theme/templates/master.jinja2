<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta syrinx-environment="{{ index.meta.environment }}" syrinx-timestamp="{{ index.meta.timestamp.isoformat() }}" syrinx-version="{{ index.meta.syrinx_version }}" />
    {% if index.meta.environment != 'production' %}<meta name="robots" content="noindex, nofollow">{% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&family=Fraunces:opsz,wght@9..144,400..600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.0/cdn/themes/light.css" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.0/cdn/shoelace-autoloader.js"></script>
    <link rel="canonical" href="{{ index.address }}">
    <link rel="sitemap" type="application/xml" href="/sitemap.xml">
    <link rel="stylesheet" href="/assets/css/index.css?v={{ index.meta.timestamp.isoformat() }}">
    {% if index.name in ["network-map", "members"] %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    {% endif %}
    <script src="/assets/js/site.js?v={{ index.meta.timestamp.isoformat() }}" defer></script>
    {% if index.name in ["network-map", "members"] %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
    <script src="/assets/js/network-map.js?v={{ index.meta.timestamp.isoformat() }}" defer></script>
    {% endif %}
    <title>EEGManyLabs | International EEG Replication Initiative</title>
</head>
<body>
  {% set nav_labels = {"people": "Core team", "members": "Members", "related_projects": "Related projects"} %}
  {% set nav_order = ["about", "replications", "people", "members", "publications", "related_projects", "partners", "contact"] %}
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header" data-site-header>
    <div class="header-inner">
      <a class="brand" href="/" aria-label="EEGManyLabs home"><img class="brand-image" src="/assets/images/logo.png" alt="EEGManyLabs"></a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {% for nav_name in nav_order %}
          {% for branch in root.branches %}
            {% if branch.buildPage and branch.name == nav_name %}
              <a href="/{{ branch.name }}/" {% if index.name == branch.name %}aria-current="page"{% endif %}>{{ nav_labels.get(branch.name, branch.name|replace("_", " "))|title }}</a>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </nav>
      <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">Open navigation</span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </header>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Site navigation">
      <div class="mobile-menu__top"><button class="menu-close" type="button" data-menu-close aria-label="Close navigation"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></button></div>
      <nav class="mobile-nav" aria-label="Primary navigation">
        {% for nav_name in nav_order %}
          {% for branch in root.branches %}
            {% if branch.buildPage and branch.name == nav_name %}
              <a href="/{{ branch.name }}/" {% if index.name == branch.name %}aria-current="page"{% endif %}>{{ nav_labels.get(branch.name, branch.name|replace("_", " "))|title }}</a>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </nav>
    </div>
  </div>
  <main id="main-content">{% block main %}{% endblock %}</main>
  <footer class="site-footer">
    <div class="footer-inner"><div class="footer-links">{% for leaf in root.leaves if leaf.name != "contact" %}{% include 'section_leaf.jinja2' %}{% endfor %}</div></div>
    <div class="footer-base"><nav aria-label="Footer information"><a href="/site_map/">Sitemap</a><a href="/privacy/">Privacy</a><a href="/contact/">Contact</a></nav></div>
  </footer>
  <script type="module">
    import { registerIconLibrary } from 'https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.0/cdn/utilities/icon-library.js';
    registerIconLibrary('fa', { resolver: name => { const filename = name.replace(/^fa[rbs]-/, ''); let folder = 'regular'; if (name.substring(0, 4) === 'fas-') folder = 'solid'; if (name.substring(0, 4) === 'fab-') folder = 'brands'; return `https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/svgs/${folder}/${filename}.svg`; }, mutator: svg => svg.setAttribute('fill', 'currentColor') });
  </script>
</body>
</html>
